//@version=6
indicator("Prizrak Trade Setup Detector v11.7.0", shorttitle="Prizrak11", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=300, format=format.price, precision=2)

// =========================
// INPUTS
// =========================
group_main = "Основные модули"
enable_accum    = input.bool(true, "Накопления", group=group_main)
enable_poc      = input.bool(true, "POC-уровни", group=group_main)
enable_stop_vol = input.bool(true, "Стоповый объём", group=group_main)
enable_traps    = input.bool(true, "Ловушки/проколы", group=group_main)
enable_choch    = input.bool(true, "PP", group=group_main)
enable_filters  = input.bool(true, "RSI/MACD фильтры", group=group_main)

group_acc = "Накопления"
touch_tolerance    = input.float(0.15, "Допуск касания границ (%)", step=0.01, minval=0.05, maxval=0.5, group=group_acc) / 100
min_touches        = input.int(4, "Мин. касаний", minval=4, maxval=10, group=group_acc)
min_touches_side   = input.int(2, "Мин. касаний на сторону", minval=1, maxval=10, group=group_acc)
flat_max_range_pct = input.float(5.0, "Макс. диапазон флэта (%)", step=0.1, minval=0.5, maxval=30, group=group_acc) / 100
flat_break_early   = input.float(0.5, "Лом структуры EARLY (%)", step=0.1, minval=0.1, maxval=5, group=group_acc) / 100
flat_break_true    = input.float(1.0, "Лом структуры TRUE (%)", step=0.1, minval=0.1, maxval=5, group=group_acc) / 100
exit_confirm_bars  = input.int(2, "Подтверждение выхода", minval=1, maxval=10, group=group_acc)
flat_len_auto      = input.bool(true, "Авто-длина по ТФ", group=group_acc)
flat_len_m15       = input.int(40, "M15", minval=10, maxval=400, group=group_acc)
flat_len_h1        = input.int(60, "H1", minval=10, maxval=400, group=group_acc)
flat_len_4h        = input.int(80, "H4", minval=10, maxval=600, group=group_acc)
max_flat_bars_man  = input.int(150, "Manual", minval=20, maxval=1000, group=group_acc)

group_poc = "POC"
poc_bins           = input.int(30, "POC bins", minval=10, maxval=200, group=group_poc)
max_poc_keep       = input.int(10, "Макс. POC", minval=1, maxval=50, group=group_poc)
poc_dead_tests     = input.int(2, "Снять после N тестов", minval=1, maxval=10, group=group_poc)
poc_test_tolerance = input.float(0.25, "Допуск теста (%)", step=0.05, minval=0.05, maxval=2, group=group_poc) / 100
poc_price_mode     = input.string("HLC3", "Цена профиля", options=["CLOSE", "HL2", "HLC3", "VWAP"], group=group_poc)
bin_min_pct        = input.float(0.05, "Мин. размер бина (%)", step=0.01, minval=0.01, maxval=1.0, group=group_poc) / 100

group_stop = "Стоповый объём"
stop_len             = input.int(30, "Длина окна", minval=10, maxval=400, group=group_stop)
stop_max_range_pct   = input.float(2.0, "Макс диапазон (%)", step=0.1, minval=0.2, maxval=10, group=group_stop) / 100
stop_vol_mult        = input.float(1.5, "Объём выше MA *", step=0.1, minval=0.5, maxval=10, group=group_stop)
stop_break_early     = input.float(0.5, "Stop EARLY break (%)", step=0.1, minval=0.1, maxval=5, group=group_stop) / 100
stop_detect_inside   = input.bool(true, "Детектировать внутри флэта", group=group_stop)
stop_exit_confirm    = input.int(2, "Подтверждение выхода", minval=1, maxval=10, group=group_stop)
stop_range_atr_mult  = input.float(1.25, "Диапазон <= ATR *", step=0.05, minval=0.2, maxval=5, group=group_stop)

group_traps = "Ловушки"
trap_max_bars = input.int(8, "Окно ловушки", minval=2, maxval=50, group=group_traps)
trap_vol_drop = input.float(0.75, "Падение объёма от MA *", step=0.05, minval=0.1, maxval=2.0, group=group_traps)
trap_use_volume = input.bool(true, "Использовать фильтр объёма", group=group_traps)
icon_cooldown = input.int(0, "Icon cooldown", minval=0, maxval=200, group=group_traps)

group_choch = "PP"
htf              = input.timeframe("240", "HTF", group=group_choch)
choch_pivot_len  = input.int(10, "Pivot length", minval=2, maxval=50, group=group_choch)
choch_pivot_cap  = input.int(10, "Pivot cap", minval=2, maxval=200, group=group_choch)
choch_break_early = input.float(0.5, "PP EARLY (%)", step=0.1, minval=0.1, maxval=5, group=group_choch) / 100
choch_break_true  = input.float(1.0, "PP TRUE (%)", step=0.1, minval=0.1, maxval=5, group=group_choch) / 100
choch_need_retest = input.bool(true, "PP need retest", group=group_choch)
choch_retest_bars = input.int(3, "PP retest bars", minval=1, maxval=20, group=group_choch)

// PP aliases over legacy choch_* runtime variables
pp_enabled = enable_choch
pp_break_early = choch_break_early
pp_break_true = choch_break_true
pp_need_retest = choch_need_retest
pp_retest_bars = choch_retest_bars

group_filters = "Фильтры"
rsi_len      = input.int(21, "RSI", minval=5, maxval=100, group=group_filters)
macd_fast    = input.int(19, "MACD fast", minval=2, maxval=50, group=group_filters)
macd_slow    = input.int(39, "MACD slow", minval=5, maxval=100, group=group_filters)
macd_sig     = input.int(9, "MACD signal", minval=2, maxval=50, group=group_filters)
div_lookback = input.int(5, "Длина дивергенции", minval=3, maxval=30, group=group_filters)

group_setups = "Сетапы"
test_atr_frac      = input.float(0.30, "ATR proximity", step=0.05, minval=0.05, maxval=3, group=group_setups)
allow_counter      = input.bool(false, "Разрешить контртренд", group=group_setups)
rr_gate_enabled    = input.bool(true, "RR gate", group=group_setups)
rr_min             = input.float(2.5, "Min RR", step=0.1, minval=0.5, maxval=10, group=group_setups)
rr_main_mult       = input.float(1.618, "Main TP mult", step=0.001, minval=0.1, maxval=10, group=group_setups)
rr_ext_mult        = input.float(2.618, "Ext TP mult", step=0.001, minval=0.1, maxval=20, group=group_setups)


group_vis = "Визуализация"
clean_mode       = input.bool(false, "Clean mode", group=group_vis)
show_boxes       = input.bool(false, "Флэт-боксы", group=group_vis)
show_working_lvl = input.bool(true, "Рабочий уровень", group=group_vis)
show_poc_lines   = input.bool(true, "Исторические POC", group=group_vis)
show_stop_line   = input.bool(true, "Линия стопа", group=group_vis)
show_squeeze     = input.bool(true, "Squeeze", group=group_vis)
squeeze_bb_len   = input.int(20, "BB length", minval=5, maxval=100, group=group_vis)
squeeze_bb_mult  = input.float(2.0, "BB mult", step=0.1, minval=1.0, maxval=4.0, group=group_vis)
squeeze_factor   = input.float(0.8, "BBW < SMA*", step=0.05, minval=0.2, maxval=1.2, group=group_vis)
target_preset    = input.bool(true, "Target preset", group=group_vis)

group_rr = "RR Overlay"
show_rr_history = input.bool(true, "Show RR history", group=group_rr)
rr_show_stat    = input.bool(true, "Show RR result labels", group=group_rr)
rr_draw_open    = input.bool(true, "Draw open trade", group=group_rr)
rr_open_extend  = input.int(5, "Open extend", minval=0, maxval=200, group=group_rr)
rr_hist_keep    = input.int(80, "History keep", minval=5, maxval=200, group=group_rr)

group_debug = "Debug"
debug_mode = input.bool(false, "Debug mode", group=group_debug)
show_debug_table = input.bool(true, "Show debug table", group=group_debug)

f_opaque(color c) => color.rgb(color.r(c), color.g(c), color.b(c))
f_with_alpha(color c, int a) => color.new(f_opaque(c), a)
color skin_contrast_dark = color.black
color skin_contrast_light = color.white
f_contrast_text(color bg) =>
    float lum = (299 * color.r(bg) + 587 * color.g(bg) + 114 * color.b(bg)) / 1000
    lum > 140 ? skin_contrast_dark : skin_contrast_light

zone_opacity_eff = target_preset ? 82 : 85
line_w_eff = target_preset ? 2 : 3
border_w_eff = target_preset ? 2 : 1
label_sz_eff = target_preset ? size.normal : size.small

skin_buy_fill = color.new(color.teal, zone_opacity_eff)
skin_sell_fill = color.new(color.purple, zone_opacity_eff)
skin_stop_fill = color.new(color.red, target_preset ? 82 : 85)
skin_take_fill = color.new(color.green, target_preset ? 82 : 85)
skin_take2_fill = color.new(color.teal, target_preset ? 84 : 87)
skin_poc_fill = color.new(color.blue, target_preset ? 87 : 90)
color skin_edge_base = target_preset ? chart.fg_color : color.black
color skin_text_base = target_preset ? chart.fg_color : color.white
skin_edge_col = color.new(skin_edge_base, 0)
skin_text_col = color.new(skin_text_base, 0)
skin_poc_line = color.new(color.yellow, 0)
skin_dead_line = color.new(color.gray, 75)
skin_trap_col = color.new(color.orange, 0)
skin_choch_col = color.new(color.fuchsia, 0)
skin_squeeze_col = color.new(color.yellow, 70)
skin_working_line_col = color.new(color.yellow, 0)
skin_stop_line_col = f_opaque(skin_stop_fill)
skin_take_text_col = f_opaque(skin_take_fill)
skin_label_size = label_sz_eff
skin_line_w = line_w_eff
skin_dead_line_w = 1
skin_border_w = border_w_eff

trap_up_style = label.style_arrowup
trap_dn_style = label.style_arrowdown
choch_up_style = label.style_arrowup
choch_dn_style = label.style_arrowdown

rr_cStop    = skin_stop_fill
rr_cTake    = skin_take_fill
rr_cTake2   = skin_take2_fill
rr_cEdge    = skin_edge_col
rr_cEntry   = skin_working_line_col
rr_cTagRisk = skin_trap_col
rr_cTagPnl  = skin_take_text_col

// =========================
// HELPERS
// =========================
f_fmt(float p) => str.tostring(p, format.mintick)
f_clamp_int(int v, int lo, int hi) => math.max(lo, math.min(hi, v))

f_box(box _bx, int _x1, float _y1, int _x2, float _y2, color _bg, color _bd, int _bw) =>
    box out = _bx
    if na(out)
        out := box.new(_x1, _y1, _x2, _y2, bgcolor=_bg, border_color=_bd, border_width=_bw)
    else
        box.set_left(out, _x1)
        box.set_right(out, _x2)
        box.set_top(out, _y1)
        box.set_bottom(out, _y2)
        box.set_bgcolor(out, _bg)
        box.set_border_color(out, _bd)
        box.set_border_width(out, _bw)
    out

f_line(line _ln, int _x1, float _y1, int _x2, float _y2, color _c, int _w) =>
    line out = _ln
    if na(out)
        out := line.new(_x1, _y1, _x2, _y2, color=_c, width=_w)
    else
        line.set_xy1(out, _x1, _y1)
        line.set_xy2(out, _x2, _y2)
        line.set_color(out, _c)
        line.set_width(out, _w)
    out

f_line_styled(line _ln, int _x1, float _y1, int _x2, float _y2, color _c, int _w, string _st) =>
    line out = _ln
    if na(out)
        out := line.new(_x1, _y1, _x2, _y2, color=_c, width=_w, style=_st)
    else
        line.set_xy1(out, _x1, _y1)
        line.set_xy2(out, _x2, _y2)
        line.set_color(out, _c)
        line.set_width(out, _w)
        line.set_style(out, _st)
    out

f_label(label _lb, int _x, float _y, string _txt, string _style, color _bg, color _tc, string _sz) =>
    label out = _lb
    if na(out)
        out := label.new(_x, _y, _txt, style=_style, color=_bg, textcolor=_tc, size=_sz)
    else
        label.set_xy(out, _x, _y)
        label.set_text(out, _txt)
        label.set_style(out, _style)
        label.set_color(out, _bg)
        label.set_textcolor(out, _tc)
        label.set_size(out, _sz)
    out

f_del_box(box b) =>
    if not na(b)
        box.delete(b)

f_del_line(line l) =>
    if not na(l)
        line.delete(l)

f_del_label(label lb) =>
    if not na(lb)
        label.delete(lb)

f_box_norm(box _bx, int _x1, float _a, int _x2, float _b, color _bg, color _bd, int _bw) =>
    float top = math.max(_a, _b)
    float bot = math.min(_a, _b)
    f_box(_bx, _x1, top, _x2, bot, _bg, _bd, _bw)

f_rr_pct(float _entry, float _exit, float _stopOrig) =>
    float risk = math.abs(_entry - _stopOrig)
    risk > 0 ? (_exit - _entry) / risk : na

f_rr_res_text(string _dir, string _res) =>
    _dir + " " + _res

f_rr_draw_one(int _x1, int _x2, string _dir, float _entry, float _stopOrig, float _takeMain, float _takeExt, string _res, box _stopBox, box _takeBox, box _take2Box, line _entryLine, label _statLabel, bool _showStat) =>
    box stopBoxOut = _stopBox
    box takeBoxOut = _takeBox
    box take2BoxOut = _take2Box
    line entryLineOut = _entryLine
    label statLabelOut = _statLabel
    if not na(_entry) and not na(_stopOrig) and not na(_takeMain)
        stopBoxOut := f_box_norm(stopBoxOut, _x1, _entry, _x2, _stopOrig, rr_cStop, rr_cEdge, skin_border_w)
        takeBoxOut := f_box_norm(takeBoxOut, _x1, _entry, _x2, _takeMain, rr_cTake, rr_cEdge, skin_border_w)
        if not na(_takeExt)
            take2BoxOut := f_box_norm(take2BoxOut, _x1, _takeMain, _x2, _takeExt, rr_cTake2, rr_cEdge, skin_border_w)
        else
            if not na(take2BoxOut)
                f_del_box(take2BoxOut)
                take2BoxOut := na
        entryLineOut := f_line_styled(entryLineOut, _x1, _entry, _x2, _entry, rr_cEntry, skin_line_w, line.style_arrow_right)
        if _showStat
            float rrv = f_rr_pct(_entry, _takeMain, _stopOrig)
            string txt = f_rr_res_text(_dir, _res) + (not na(rrv) ? " | RR " + str.tostring(rrv, "#.##") : "")
            color tagColor = str.contains(_res, "SL") ? rr_cTagRisk : rr_cTagPnl
            statLabelOut := f_label(statLabelOut, _x2, _entry, txt, label.style_label_left, tagColor, f_contrast_text(tagColor), skin_label_size)
        else
            if not na(statLabelOut)
                f_del_label(statLabelOut)
                statLabelOut := na
    [stopBoxOut, takeBoxOut, take2BoxOut, entryLineOut, statLabelOut]

f_bar_price(int off) =>
    float p = na
    if poc_price_mode == "CLOSE"
        p := close[off]
    else if poc_price_mode == "HL2"
        p := (high[off] + low[off]) / 2.0
    else
        p := (high[off] + low[off] + close[off]) / 3.0
    p

f_bin_size(float lo, float hi) =>
    float rng = hi - lo
    float min_bin = math.max(rng * bin_min_pct, syminfo.mintick)
    math.max(rng / poc_bins, min_bin)

calculatePOC(int start_bar, int end_bar, float lo, float hi) =>
    float rng = hi - lo
    if rng <= 0 or poc_bins <= 1
        na
    else
        float bsz = f_bin_size(lo, hi)
        if na(bsz) or bsz <= 0
            na
        else
            int bins_actual = int(math.max(2, math.ceil((hi - lo) / bsz)))
            array<float> vols = array.new_float(bins_actual, 0.0)
            float cum_pv = 0.0
            float cum_v = 0.0
            for b = start_bar to end_bar
                int off = bar_index - b
                if off >= 0 and off <= bar_index
                    float bv = volume[off]
                    if not na(bv) and bv > 0
                        float bp = na
                        if poc_price_mode == "VWAP"
                            float tp = (high[off] + low[off] + close[off]) / 3.0
                            cum_pv += tp * bv
                            cum_v += bv
                            bp := cum_v > 0 ? (cum_pv / cum_v) : tp
                        else
                            bp := f_bar_price(off)
                        if not na(bp) and bp >= lo and bp <= hi
                            int idx = int(math.floor((bp - lo) / bsz))
                            idx := f_clamp_int(idx, 0, bins_actual - 1)
                            array.set(vols, idx, array.get(vols, idx) + bv)
            float maxv = 0.0
            float poc = na
            for i = 0 to bins_actual - 1
                float v = array.get(vols, i)
                if v > maxv
                    maxv := v
                    poc := lo + (i + 0.5) * bsz
            poc

// =========================
// TECH DATA
// =========================
is_m15 = timeframe.isminutes and timeframe.multiplier == 15
is_h1  = timeframe.isminutes and timeframe.multiplier == 60
is_4h  = timeframe.isminutes and timeframe.multiplier == 240
max_flat_bars = flat_len_auto ? (is_m15 ? flat_len_m15 : is_h1 ? flat_len_h1 : is_4h ? flat_len_4h : max_flat_bars_man) : max_flat_bars_man

atr = ta.atr(14)
vol_ma = ta.sma(volume, 50)
rsi = ta.rsi(close, rsi_len)
[macd_line, macd_signal, _] = ta.macd(close, macd_fast, macd_slow, macd_sig)

bbw = ta.bbw(close, squeeze_bb_len, squeeze_bb_mult)
bbw_ma = ta.sma(bbw, squeeze_bb_len)
squeeze = not na(bbw_ma) and bbw <= bbw_ma * squeeze_factor
barcolor(show_squeeze and not clean_mode and squeeze ? skin_squeeze_col : na)

// =========================
// STATE
// =========================
var bool in_flat = false
var int flat_start = na
var float flat_high = na
var float flat_low = na
var int touches_top = 0
var int touches_bottom = 0
var int exit_confirm_cnt = 0

var float last_flat_high = na
var float last_flat_low = na
var bool last_flat_valid = false

var array<float> poc_prices = array.new_float()
var array<int> poc_bars = array.new_int()
var array<int> poc_tests = array.new_int()

var bool in_stop = false
var int stop_start = na
var float stop_high = na
var float stop_low = na
var int stop_exit_cnt = 0

var int last_break_bar = na
var string last_break_dir = ""

var bool choch_active = false
var int choch_kind = 0
var int choch_pending_dir = 0
var int choch_pending_kind = 0
var float choch_pending_level = na
var int choch_pending_bar = na
var int choch_confirm_dir = 0
var int choch_confirm_kind = 0
var float choch_confirm_level = na
var int choch_confirm_bar = na
var int choch_confirm_count = 0
var int htf_trend_dir_cache = 0

var bool position_active = false
var string position_dir = ""
var float entry_price = na
var float stop_price = na
var float tp_main = na
var float tp_ext = na
var float breakeven_price = na

var bool open_active = false
var string open_dir = ""
var float open_entry = na
var float open_stopOrig = na
var float open_takeMain = na
var float open_takeExt = na
var int open_entryBar = na
var int open_lastBar = na

var array<string> log_dir = array.new_string()
var array<float> log_entry = array.new_float()
var array<float> log_exit = array.new_float()
var array<float> log_rr = array.new_float()
var array<string> log_res = array.new_string()
var array<int> log_entryBar = array.new_int()
var array<int> log_exitBar = array.new_int()
var array<float> log_stopOrig = array.new_float()
var array<float> log_takeMain = array.new_float()
var array<float> log_takeExt = array.new_float()

var int last_trap_up_icon_bar = na
var int last_trap_down_icon_bar = na
var int last_choch_icon_bar = na

var table debug_table = na

// =========================
// ACCUMULATION
// =========================
cand_high = ta.highest(high, max_flat_bars)
cand_low = ta.lowest(low, max_flat_bars)
cand_rng = cand_high - cand_low
cand_rng_pct = cand_rng / math.max(cand_low, syminfo.mintick)

cand_touch_top = 0
cand_touch_bot = 0
if enable_accum and not in_flat and bar_index >= max_flat_bars
    for i = 0 to max_flat_bars - 1
        cand_touch_top += high[i] >= cand_high * (1 - touch_tolerance) ? 1 : 0
        cand_touch_bot += low[i] <= cand_low * (1 + touch_tolerance) ? 1 : 0

int min_touch_req = math.max(min_touches, 4)
bool htf_priority_flat_ok = not pp_enabled or htf_trend_dir_cache != 0
cand_ok = enable_accum and not in_flat and bar_index >= max_flat_bars and htf_priority_flat_ok and cand_rng_pct <= flat_max_range_pct and cand_touch_top + cand_touch_bot >= min_touch_req and cand_touch_top >= min_touches_side and cand_touch_bot >= min_touches_side
if cand_ok
    in_flat := true
    flat_start := bar_index - max_flat_bars + 1
    flat_high := cand_high
    flat_low := cand_low
    touches_top := cand_touch_top
    touches_bottom := cand_touch_bot
    exit_confirm_cnt := 0

if in_flat
    outside_early = high > flat_high * (1 + flat_break_early) or low < flat_low * (1 - flat_break_early)
    outside_true = high > flat_high * (1 + flat_break_true) or low < flat_low * (1 - flat_break_true)
    outside_any = close > flat_high or close < flat_low

    touch_top = high >= flat_high * (1 - touch_tolerance) and high <= flat_high * (1 + touch_tolerance)
    touch_bot = low >= flat_low * (1 - touch_tolerance) and low <= flat_low * (1 + touch_tolerance)
    touches_top += touch_top ? 1 : 0
    touches_bottom += touch_bot ? 1 : 0

    if outside_any and not outside_early
        exit_confirm_cnt += 1
    else
        exit_confirm_cnt := 0

    bool finalize = outside_early or outside_true or exit_confirm_cnt >= exit_confirm_bars or (bar_index - flat_start) > max_flat_bars
    if finalize
        bool flat_valid = htf_priority_flat_ok and (touches_top + touches_bottom) >= min_touch_req and touches_top >= min_touches_side and touches_bottom >= min_touches_side
        if enable_poc and flat_valid
            float fpoc = calculatePOC(flat_start, math.max(flat_start, bar_index - 1), flat_low, flat_high)
            if not na(fpoc)
                array.push(poc_prices, fpoc)
                array.push(poc_bars, bar_index)
                array.push(poc_tests, 0)
                if array.size(poc_prices) > max_poc_keep
                    array.shift(poc_prices)
                    array.shift(poc_bars)
                    array.shift(poc_tests)
                while array.size(poc_prices) > math.max(max_poc_keep, 1)
                    array.shift(poc_prices)
                    array.shift(poc_bars)
                    array.shift(poc_tests)
        last_flat_high := flat_high
        last_flat_low := flat_low
        last_flat_valid := flat_valid
        in_flat := false
        flat_start := na
        flat_high := na
        flat_low := na
        touches_top := 0
        touches_bottom := 0
        exit_confirm_cnt := 0

// =========================
// STOP VOLUME
// =========================
s_hi = ta.highest(high, stop_len)
s_lo = ta.lowest(low, stop_len)
s_rng = s_hi - s_lo
s_rng_pct = s_rng / math.max(s_lo, syminfo.mintick)
s_vol_sum = math.sum(volume, stop_len)

if enable_stop_vol and not in_stop and bar_index >= stop_len
    bool rng_ok = s_rng_pct <= stop_max_range_pct and s_rng <= atr * stop_range_atr_mult
    bool vol_ok = s_vol_sum >= vol_ma * stop_vol_mult * stop_len
    bool flat_ok = not in_flat or stop_detect_inside
    if rng_ok and vol_ok and flat_ok
        in_stop := true
        stop_start := bar_index - stop_len + 1
        stop_high := s_hi
        stop_low := s_lo
        stop_exit_cnt := 0

if in_stop
    stop_out_early = high > stop_high * (1 + stop_break_early) or low < stop_low * (1 - stop_break_early)
    stop_out_any = close > stop_high or close < stop_low
    if stop_out_any and not stop_out_early
        stop_exit_cnt += 1
    else
        stop_exit_cnt := 0
    if stop_out_early or stop_exit_cnt >= stop_exit_confirm
        if enable_poc
            sv_poc = calculatePOC(stop_start, math.max(stop_start, bar_index - 1), stop_low, stop_high)
            if not na(sv_poc)
                array.push(poc_prices, sv_poc)
                array.push(poc_bars, bar_index)
                array.push(poc_tests, 0)
                if array.size(poc_prices) > max_poc_keep
                    array.shift(poc_prices)
                    array.shift(poc_bars)
                    array.shift(poc_tests)
                while array.size(poc_prices) > math.max(max_poc_keep, 1)
                    array.shift(poc_prices)
                    array.shift(poc_bars)
                    array.shift(poc_tests)
        in_stop := false
        stop_start := na
        stop_high := na
        stop_low := na
        stop_exit_cnt := 0

// =========================
// PP (DEV): variable names keep choch_* for backward wiring compatibility.
// =========================
[htf_ph_raw, htf_pl_raw] = request.security(syminfo.tickerid, htf, [ta.pivothigh(high, choch_pivot_len, choch_pivot_len), ta.pivotlow(low, choch_pivot_len, choch_pivot_len)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, calc_bars_count=math.max(500, choch_pivot_cap * (choch_pivot_len * 2 + 10)))
float htf_ph = na(htf_ph_raw) ? na : htf_ph_raw
float htf_pl = na(htf_pl_raw) ? na : htf_pl_raw
var array<float> htf_highs = array.new_float()
var array<float> htf_lows = array.new_float()
var array<int> htf_high_bars = array.new_int()
var array<int> htf_low_bars = array.new_int()
var float pp_early_dn_level = na
var float pp_early_dn_ref_high = na
var float pp_early_up_level = na
var float pp_early_up_ref_low = na
int pp_confirm_bars = 2

bool new_htf_high = not na(htf_ph) and (array.size(htf_highs) == 0 or htf_ph != array.get(htf_highs, array.size(htf_highs) - 1))
bool new_htf_low = not na(htf_pl) and (array.size(htf_lows) == 0 or htf_pl != array.get(htf_lows, array.size(htf_lows) - 1))

if new_htf_high
    array.push(htf_highs, htf_ph)
    array.push(htf_high_bars, math.max(bar_index - choch_pivot_len, 0))
    if array.size(htf_highs) > choch_pivot_cap
        array.shift(htf_highs)
        array.shift(htf_high_bars)
if new_htf_low
    array.push(htf_lows, htf_pl)
    array.push(htf_low_bars, math.max(bar_index - choch_pivot_len, 0))
    if array.size(htf_lows) > choch_pivot_cap
        array.shift(htf_lows)
        array.shift(htf_low_bars)

htf_ready = array.size(htf_highs) >= 2 and array.size(htf_lows) >= 2
float htf_last_hh = na
float htf_last_ll = na
int htf_trend_dir = 0
if htf_ready
    htf_last_hh := array.get(htf_highs, array.size(htf_highs) - 1)
    float htf_prev_hh = array.get(htf_highs, array.size(htf_highs) - 2)
    htf_last_ll := array.get(htf_lows, array.size(htf_lows) - 1)
    float htf_prev_ll = array.get(htf_lows, array.size(htf_lows) - 2)
    bool htf_trend_up = htf_last_ll > htf_prev_ll
    bool htf_trend_down = htf_last_hh < htf_prev_hh
    htf_trend_dir := htf_trend_up and not htf_trend_down ? 1 : htf_trend_down and not htf_trend_up ? -1 : 0
htf_trend_dir_cache := htf_trend_dir

choch_active := false
choch_kind := 0
bool pending_alive = false
bool confirm_alive = false
if pp_enabled and htf_ready
    if new_htf_low and not na(htf_last_hh)
        pp_early_dn_level := array.get(htf_lows, array.size(htf_lows) - 1)
        pp_early_dn_ref_high := htf_last_hh
    if new_htf_high and not na(htf_last_ll)
        pp_early_up_level := array.get(htf_highs, array.size(htf_highs) - 1)
        pp_early_up_ref_low := htf_last_ll

    float true_dn_level = not na(htf_last_ll) ? htf_last_ll * (1 - pp_break_true) : na
    float true_up_level = not na(htf_last_hh) ? htf_last_hh * (1 + pp_break_true) : na
    bool true_dn_break = not na(true_dn_level) and close < true_dn_level and close[1] >= true_dn_level
    bool true_up_break = not na(true_up_level) and close > true_up_level and close[1] <= true_up_level

    float early_dn_level = not na(pp_early_dn_level) ? pp_early_dn_level * (1 - pp_break_early) : na
    float early_up_level = not na(pp_early_up_level) ? pp_early_up_level * (1 + pp_break_early) : na
    bool early_dn_break = not na(early_dn_level) and close < early_dn_level and close[1] >= early_dn_level
    bool early_up_break = not na(early_up_level) and close > early_up_level and close[1] <= early_up_level
    bool early_dn_guard = not na(pp_early_dn_ref_high) and htf_last_hh <= pp_early_dn_ref_high
    bool early_up_guard = not na(pp_early_up_ref_low) and htf_last_ll >= pp_early_up_ref_low

    int break_kind = true_dn_break ? 2 : true_up_break ? 4 : early_dn_break and early_dn_guard ? 1 : early_up_break and early_up_guard ? 3 : 0
    int break_dir = break_kind == 1 or break_kind == 2 ? -1 : break_kind == 3 or break_kind == 4 ? 1 : 0
    float break_level = break_kind == 2 ? htf_last_ll : break_kind == 4 ? htf_last_hh : break_kind == 1 ? pp_early_dn_level : break_kind == 3 ? pp_early_up_level : na

    if break_kind != 0 and choch_pending_dir == 0 and choch_confirm_dir == 0
        if pp_need_retest
            choch_pending_dir := break_dir
            choch_pending_kind := break_kind
            choch_pending_level := break_level
            choch_pending_bar := bar_index
        else
            choch_confirm_dir := break_dir
            choch_confirm_kind := break_kind
            choch_confirm_level := break_level
            choch_confirm_bar := bar_index
            choch_confirm_count := 0

    pending_alive := choch_pending_dir != 0 and not na(choch_pending_bar) and (bar_index - choch_pending_bar) <= pp_retest_bars
    if pending_alive
        bool retest_hit = choch_pending_dir == -1 ? (high >= choch_pending_level and close < choch_pending_level) : (low <= choch_pending_level and close > choch_pending_level)
        if retest_hit
            choch_confirm_dir := choch_pending_dir
            choch_confirm_kind := choch_pending_kind
            choch_confirm_level := choch_pending_level
            choch_confirm_bar := bar_index
            choch_confirm_count := 0
            choch_pending_dir := 0
            choch_pending_kind := 0
            choch_pending_level := na
            choch_pending_bar := na
    else
        choch_pending_dir := 0
        choch_pending_kind := 0
        choch_pending_level := na
        choch_pending_bar := na

    confirm_alive := choch_confirm_dir != 0 and not na(choch_confirm_bar) and (bar_index - choch_confirm_bar) <= pp_retest_bars
    if confirm_alive
        float confirm_thr = choch_confirm_kind == 2 or choch_confirm_kind == 4 ? pp_break_true : pp_break_early
        float confirm_level = choch_confirm_dir == -1 ? choch_confirm_level * (1 - confirm_thr) : choch_confirm_level * (1 + confirm_thr)
        bool confirm_bar_ok = choch_confirm_dir == -1 ? close < confirm_level : close > confirm_level
        choch_confirm_count := confirm_bar_ok ? choch_confirm_count + 1 : 0
        if choch_confirm_count >= pp_confirm_bars
            choch_active := true
            choch_kind := choch_confirm_kind
            choch_confirm_dir := 0
            choch_confirm_kind := 0
            choch_confirm_level := na
            choch_confirm_bar := na
            choch_confirm_count := 0
    else
        choch_confirm_dir := 0
        choch_confirm_kind := 0
        choch_confirm_level := na
        choch_confirm_bar := na
        choch_confirm_count := 0
else
    choch_pending_dir := 0
    choch_pending_kind := 0
    choch_pending_level := na
    choch_pending_bar := na
    choch_confirm_dir := 0
    choch_confirm_kind := 0
    choch_confirm_level := na
    choch_confirm_bar := na
    choch_confirm_count := 0

// =========================
// WORKING LEVEL + TESTS + TRAPS
// =========================
if enable_poc and array.size(poc_prices) > 0
    for i = 0 to array.size(poc_prices) - 1
        lvl = array.get(poc_prices, i)
        tests = array.get(poc_tests, i)
        if bar_index > array.get(poc_bars, i)
            hiTol = lvl * (1 + poc_test_tolerance)
            loTol = lvl * (1 - poc_test_tolerance)
            touched = high >= loTol and low <= hiTol
            if touched
                array.set(poc_tests, i, tests + 1)

float working_level = na
if array.size(poc_prices) > 0
    for j = 0 to array.size(poc_prices) - 1
        i = array.size(poc_prices) - 1 - j
        if array.get(poc_tests, i) < poc_dead_tests
            working_level := array.get(poc_prices, i)
            break

bool work_cross_up_raw = ta.crossover(close, working_level)
bool work_cross_dn_raw = ta.crossunder(close, working_level)
bool work_cross_up = not na(working_level) and work_cross_up_raw
bool work_cross_dn = not na(working_level) and work_cross_dn_raw

if enable_traps and not na(working_level)
    bool vol_break_ok = not trap_use_volume or volume > vol_ma * 1.2
    brk_up = close > working_level and close[1] <= working_level and vol_break_ok
    brk_dn = close < working_level and close[1] >= working_level and vol_break_ok
    if brk_up
        last_break_bar := bar_index
        last_break_dir := "up"
    if brk_dn
        last_break_bar := bar_index
        last_break_dir := "down"

trap_up = false
trap_down = false
if not na(last_break_bar) and not na(working_level)
    in_window = (bar_index - last_break_bar) <= trap_max_bars
    bool vol_trap_ok = not trap_use_volume or volume < vol_ma * trap_vol_drop
    trap_up := last_break_dir == "up" and in_window and close < working_level and vol_trap_ok
    trap_down := last_break_dir == "down" and in_window and close > working_level and vol_trap_ok

bool trap_up_icon = trap_up and (icon_cooldown == 0 or na(last_trap_up_icon_bar) or (bar_index - last_trap_up_icon_bar >= icon_cooldown))
bool trap_down_icon = trap_down and (icon_cooldown == 0 or na(last_trap_down_icon_bar) or (bar_index - last_trap_down_icon_bar >= icon_cooldown))
bool choch_true_evt = choch_active and (choch_kind == 2 or choch_kind == 4)
bool choch_icon = choch_true_evt and (icon_cooldown == 0 or na(last_choch_icon_bar) or (bar_index - last_choch_icon_bar >= icon_cooldown))

bool choch_block = choch_active or (pp_need_retest and choch_pending_dir != 0 and pending_alive) or (choch_confirm_dir != 0 and confirm_alive)

inner_buy = false
inner_sell = false
if trap_up_icon
    last_trap_up_icon_bar := bar_index
if trap_down_icon
    last_trap_down_icon_bar := bar_index
if choch_icon
    last_choch_icon_bar := bar_index

// =========================
// FILTERS + SETUPS
// =========================
hidden_bull  = low > low[div_lookback] and rsi < rsi[div_lookback]
hidden_bear  = high < high[div_lookback] and rsi > rsi[div_lookback]
classic_bull = low < low[div_lookback] and rsi > rsi[div_lookback]
classic_bear = high > high[div_lookback] and rsi < rsi[div_lookback]
macd_bull = macd_line > macd_signal
macd_bear = macd_line < macd_signal

bull_ok = not enable_filters or ((hidden_bull or classic_bull or macd_bull) and not hidden_bear and not classic_bear and not macd_bear)
bear_ok = not enable_filters or ((hidden_bear or classic_bear or macd_bear) and not hidden_bull and not classic_bull and not macd_bull)

float atr_ref = atr
near_level = not na(working_level) ? math.abs(close - working_level) <= atr_ref * test_atr_frac : false
bool htf_buy_priority = htf_trend_dir == 1
buy_setup = not choch_block and work_cross_up and (htf_buy_priority or allow_counter) and bull_ok and near_level
bool htf_sell_priority = htf_trend_dir == -1
sell_setup = not choch_block and work_cross_dn and (htf_sell_priority or allow_counter) and bear_ok and near_level

open_buy = buy_setup
open_sell = sell_setup
if rr_gate_enabled and (open_buy or open_sell)
    float st_buy = not na(last_flat_low) and last_flat_valid ? last_flat_low : close - atr
    float st_sell = not na(last_flat_high) and last_flat_valid ? last_flat_high : close + atr
    float risk_buy = math.abs(close - st_buy)
    float risk_sell = math.abs(close - st_sell)
    float rr_main_candidate = rr_main_mult
    float rr_ext_candidate = rr_ext_mult
    bool rr_mult_ok = math.max(rr_main_candidate, rr_ext_candidate) >= rr_min
    bool rr_ok_buy = risk_buy > 0 and rr_mult_ok
    bool rr_ok_sell = risk_sell > 0 and rr_mult_ok
    open_buy := open_buy and rr_ok_buy
    open_sell := open_sell and rr_ok_sell

if not position_active and (open_buy or open_sell)
    position_active := true
    position_dir := open_buy ? "BUY" : "SELL"
    entry_price := close
    stop_price := position_dir == "BUY" ? (not na(last_flat_low) and last_flat_valid ? last_flat_low : close - atr) : (not na(last_flat_high) and last_flat_valid ? last_flat_high : close + atr)
    float risk = math.abs(entry_price - stop_price)
    tp_main := position_dir == "BUY" ? entry_price + risk * rr_main_mult : entry_price - risk * rr_main_mult
    tp_ext := position_dir == "BUY" ? entry_price + risk * rr_ext_mult : entry_price - risk * rr_ext_mult
    breakeven_price := na

    open_active := true
    open_dir := position_dir
    open_entry := entry_price
    open_stopOrig := stop_price
    open_takeMain := tp_main
    open_takeExt := tp_ext
    open_entryBar := bar_index
    open_lastBar := bar_index

if position_active
    open_lastBar := bar_index
    float risk = math.abs(entry_price - open_stopOrig)
    float tp1 = position_dir == "BUY" ? entry_price + risk : entry_price - risk
    bool tp1_hit = position_dir == "BUY" ? high >= tp1 : low <= tp1
    if tp1_hit and na(breakeven_price)
        breakeven_price := entry_price
        stop_price := entry_price

    bool tp_main_hit = position_dir == "BUY" ? high >= tp_main : low <= tp_main
    bool tp_ext_hit = position_dir == "BUY" ? high >= tp_ext : low <= tp_ext
    bool stop_hit = position_dir == "BUY" ? low <= stop_price : high >= stop_price

    if tp_ext_hit or tp_main_hit or stop_hit
        float exit_price = tp_ext_hit ? tp_ext : tp_main_hit ? tp_main : stop_price
        string exit_res = tp_ext_hit ? "TP2" : tp_main_hit ? "TP1" : "SL"
        float rr_res = f_rr_pct(open_entry, exit_price, open_stopOrig)

        array.push(log_dir, open_dir)
        array.push(log_entry, open_entry)
        array.push(log_exit, exit_price)
        array.push(log_rr, rr_res)
        array.push(log_res, exit_res)
        array.push(log_entryBar, open_entryBar)
        array.push(log_exitBar, bar_index)
        array.push(log_stopOrig, open_stopOrig)
        array.push(log_takeMain, open_takeMain)
        array.push(log_takeExt, open_takeExt)

        while array.size(log_dir) > rr_hist_keep
            array.shift(log_dir)
            array.shift(log_entry)
            array.shift(log_exit)
            array.shift(log_rr)
            array.shift(log_res)
            array.shift(log_entryBar)
            array.shift(log_exitBar)
            array.shift(log_stopOrig)
            array.shift(log_takeMain)
            array.shift(log_takeExt)

        position_active := false
        position_dir := ""
        entry_price := na
        stop_price := na
        tp_main := na
        tp_ext := na
        breakeven_price := na

        open_active := false
        open_dir := ""
        open_entry := na
        open_stopOrig := na
        open_takeMain := na
        open_takeExt := na
        open_entryBar := na
        open_lastBar := na

// =========================
// VISUALS
// =========================
bool flat_valid_now = in_flat and (not pp_enabled or htf_trend_dir_cache != 0) and (touches_top + touches_bottom >= math.max(min_touches, 4)) and touches_top >= min_touches_side and touches_bottom >= min_touches_side
var box flatBox = na
if not clean_mode and show_boxes and in_flat and not na(flat_start) and not na(flat_high) and not na(flat_low) and flat_valid_now
    color flat_bg = htf_trend_dir == 1 ? skin_buy_fill : htf_trend_dir == -1 ? skin_sell_fill : skin_poc_fill
    flatBox := f_box(flatBox, flat_start, flat_high, bar_index, flat_low, flat_bg, skin_edge_col, skin_border_w)
else
    if not na(flatBox)
        f_del_box(flatBox)
        flatBox := na

var line wl = na
var label wll = na
if not clean_mode and show_working_lvl and not na(working_level)
    wl := f_line_styled(wl, bar_index - 100, working_level, bar_index, working_level, skin_working_line_col, skin_line_w, line.style_arrow_right)
    wll := f_label(wll, bar_index + 2, working_level, "POC " + f_fmt(working_level), label.style_label_left, skin_poc_fill, f_contrast_text(skin_poc_fill), skin_label_size)
else
    if not na(wl)
        f_del_line(wl)
        wl := na
    if not na(wll)
        f_del_label(wll)
        wll := na

var array<line> poc_lines = array.new_line()
if not clean_mode and show_poc_lines and enable_poc
    while array.size(poc_lines) < array.size(poc_prices)
        array.push(poc_lines, na)
    while array.size(poc_lines) > array.size(poc_prices)
        f_del_line(array.pop(poc_lines))
    if array.size(poc_prices) > 0
        for i = 0 to array.size(poc_prices) - 1
            float lvl = array.get(poc_prices, i)
            int tests = array.get(poc_tests, i)
            color c = tests >= poc_dead_tests ? skin_dead_line : skin_poc_line
            line ln = array.get(poc_lines, i)
            ln := f_line_styled(ln, array.get(poc_bars, i), lvl, bar_index, lvl, c, tests >= poc_dead_tests ? skin_dead_line_w : skin_line_w, tests >= poc_dead_tests ? line.style_dashed : line.style_arrow_right)
            array.set(poc_lines, i, ln)
else
    while array.size(poc_lines) > 0
        f_del_line(array.pop(poc_lines))

var line sl = na
if not clean_mode and show_stop_line and position_active and not na(stop_price)
    sl := f_line_styled(sl, bar_index - 20, stop_price, bar_index, stop_price, skin_stop_line_col, skin_line_w, line.style_arrow_right)
else
    if not na(sl)
        f_del_line(sl)
        sl := na

var label trapUpLabel = na
var label trapDownLabel = na
var label chochLabel = na
if not clean_mode and trap_up_icon
    trapUpLabel := f_label(trapUpLabel, bar_index, low, "🪤", target_preset ? trap_up_style : label.style_label_up, skin_trap_col, f_contrast_text(skin_trap_col), skin_label_size)
if not clean_mode and trap_down_icon
    trapDownLabel := f_label(trapDownLabel, bar_index, high, "🪤", target_preset ? trap_dn_style : label.style_label_down, skin_trap_col, f_contrast_text(skin_trap_col), skin_label_size)
if not clean_mode and choch_icon
    choch_style = target_preset ? (choch_kind == 2 ? choch_up_style : choch_kind == 4 ? choch_dn_style : label.style_label_left) : label.style_label_left
    chochLabel := f_label(chochLabel, bar_index, close, "PP", choch_style, skin_choch_col, f_contrast_text(skin_choch_col), skin_label_size)

var box rr_open_stop_box = na
var box rr_open_take_box = na
var box rr_open_take2_box = na
var line rr_open_entry_line = na
var label rr_open_stat_label = na
if rr_draw_open and open_active and not clean_mode
    int rr_right = bar_index + rr_open_extend
    [rr_open_stop_box, rr_open_take_box, rr_open_take2_box, rr_open_entry_line, rr_open_stat_label] = f_rr_draw_one(open_entryBar, rr_right, open_dir, open_entry, open_stopOrig, open_takeMain, open_takeExt, "OPEN", rr_open_stop_box, rr_open_take_box, rr_open_take2_box, rr_open_entry_line, rr_open_stat_label, rr_show_stat)
else
    if not na(rr_open_stop_box)
        f_del_box(rr_open_stop_box)
        rr_open_stop_box := na
    if not na(rr_open_take_box)
        f_del_box(rr_open_take_box)
        rr_open_take_box := na
    if not na(rr_open_take2_box)
        f_del_box(rr_open_take2_box)
        rr_open_take2_box := na
    if not na(rr_open_entry_line)
        f_del_line(rr_open_entry_line)
        rr_open_entry_line := na
    if not na(rr_open_stat_label)
        f_del_label(rr_open_stat_label)
        rr_open_stat_label := na

var array<box> rr_hist_stop_boxes = array.new_box()
var array<box> rr_hist_take_boxes = array.new_box()
var array<box> rr_hist_take2_boxes = array.new_box()
var array<line> rr_hist_entry_lines = array.new_line()
var array<label> rr_hist_stat_labels = array.new_label()
if show_rr_history and not clean_mode and barstate.islast
    int n = array.size(log_dir)
    while array.size(rr_hist_stop_boxes) < n
        array.push(rr_hist_stop_boxes, na)
        array.push(rr_hist_take_boxes, na)
        array.push(rr_hist_take2_boxes, na)
        array.push(rr_hist_entry_lines, na)
        array.push(rr_hist_stat_labels, na)
    while array.size(rr_hist_stop_boxes) > n
        f_del_box(array.pop(rr_hist_stop_boxes))
        f_del_box(array.pop(rr_hist_take_boxes))
        f_del_box(array.pop(rr_hist_take2_boxes))
        f_del_line(array.pop(rr_hist_entry_lines))
        f_del_label(array.pop(rr_hist_stat_labels))
    if n > 0
        for i = 0 to n - 1
            int x1 = array.get(log_entryBar, i)
            int x2 = array.get(log_exitBar, i)
            string d = array.get(log_dir, i)
            float en = array.get(log_entry, i)
            float st = array.get(log_stopOrig, i)
            float tm = array.get(log_takeMain, i)
            float te = array.get(log_takeExt, i)
            string rs = array.get(log_res, i)
            box sb = array.get(rr_hist_stop_boxes, i)
            box tb = array.get(rr_hist_take_boxes, i)
            box t2 = array.get(rr_hist_take2_boxes, i)
            line el = array.get(rr_hist_entry_lines, i)
            label slb = array.get(rr_hist_stat_labels, i)
            [sb, tb, t2, el, slb] = f_rr_draw_one(x1, x2, d, en, st, tm, te, rs, sb, tb, t2, el, slb, rr_show_stat)
            array.set(rr_hist_stop_boxes, i, sb)
            array.set(rr_hist_take_boxes, i, tb)
            array.set(rr_hist_take2_boxes, i, t2)
            array.set(rr_hist_entry_lines, i, el)
            array.set(rr_hist_stat_labels, i, slb)
else if barstate.islast
    while array.size(rr_hist_stop_boxes) > 0
        f_del_box(array.pop(rr_hist_stop_boxes))
        f_del_box(array.pop(rr_hist_take_boxes))
        f_del_box(array.pop(rr_hist_take2_boxes))
        f_del_line(array.pop(rr_hist_entry_lines))
        f_del_label(array.pop(rr_hist_stat_labels))


// =========================
// DEBUG
// =========================
float debug_flat_mid = (in_flat and not na(flat_high) and not na(flat_low)) ? (flat_high + flat_low) / 2.0 : na
int debug_pp_state = choch_active ? choch_kind : choch_confirm_dir != 0 and confirm_alive ? choch_confirm_kind : choch_pending_dir != 0 and pending_alive ? choch_pending_kind : 0
int debug_rr_gate_state = (open_buy or open_sell) ? 1 : 0
int debug_flat_valid_state = last_flat_valid ? 1 : 0
float debug_poc_level = working_level
int debug_trap_flags = trap_up ? 1 : trap_down ? -1 : 0
float debug_rr_main_mult = rr_main_mult
float debug_rr_ext_mult = rr_ext_mult
int debug_pp_pending = choch_pending_dir != 0 and pending_alive ? 1 : 0
int debug_pp_confirm = choch_confirm_dir != 0 and confirm_alive ? 1 : 0
int debug_pp_pending_left = debug_pp_pending == 1 and not na(choch_pending_bar) ? math.max(pp_retest_bars - (bar_index - choch_pending_bar), 0) : 0
int debug_pp_confirm_left = debug_pp_confirm == 1 and not na(choch_confirm_bar) ? math.max(pp_retest_bars - (bar_index - choch_confirm_bar), 0) : 0
float debug_last_pivot_high = htf_last_hh
float debug_last_pivot_low = htf_last_ll
int debug_htf_trend_dir = htf_trend_dir

if debug_mode and show_debug_table and barstate.islast
    if na(debug_table)
        debug_table := table.new(position.top_right, 2, 16, border_width=1)
    table.cell(debug_table, 0, 0, "flat_mid")
    table.cell(debug_table, 1, 0, str.tostring(debug_flat_mid, format.mintick))
    table.cell(debug_table, 0, 1, "flat_valid")
    table.cell(debug_table, 1, 1, str.tostring(debug_flat_valid_state))
    table.cell(debug_table, 0, 2, "stop_price")
    table.cell(debug_table, 1, 2, str.tostring(stop_price, format.mintick))
    table.cell(debug_table, 0, 3, "pp_state")
    table.cell(debug_table, 1, 3, str.tostring(debug_pp_state))
    table.cell(debug_table, 0, 4, "pp_pending")
    table.cell(debug_table, 1, 4, str.tostring(debug_pp_pending) + "(" + str.tostring(debug_pp_pending_left) + ")")
    table.cell(debug_table, 0, 5, "pp_confirm")
    table.cell(debug_table, 1, 5, str.tostring(debug_pp_confirm) + "(" + str.tostring(debug_pp_confirm_left) + ")")
    table.cell(debug_table, 0, 6, "htf_trend_dir")
    table.cell(debug_table, 1, 6, str.tostring(debug_htf_trend_dir))
    table.cell(debug_table, 0, 7, "pivot_h/pivot_l")
    table.cell(debug_table, 1, 7, str.tostring(debug_last_pivot_high, format.mintick) + "/" + str.tostring(debug_last_pivot_low, format.mintick))
    table.cell(debug_table, 0, 8, "rr_gate")
    table.cell(debug_table, 1, 8, str.tostring(debug_rr_gate_state))
    table.cell(debug_table, 0, 9, "poc_level")
    table.cell(debug_table, 1, 9, str.tostring(debug_poc_level, format.mintick))
    table.cell(debug_table, 0, 10, "trap_flags")
    table.cell(debug_table, 1, 10, str.tostring(debug_trap_flags))
    table.cell(debug_table, 0, 11, "rr_main/rr_ext")
    table.cell(debug_table, 1, 11, str.tostring(debug_rr_main_mult, "#.###") + "/" + str.tostring(debug_rr_ext_mult, "#.###"))
    table.cell(debug_table, 0, 12, "in_flat/in_stop")
    table.cell(debug_table, 1, 12, str.tostring(in_flat ? 1 : 0) + "/" + str.tostring(in_stop ? 1 : 0))
    table.cell(debug_table, 0, 13, "poc_count")
    table.cell(debug_table, 1, 13, str.tostring(array.size(poc_prices)))
    table.cell(debug_table, 0, 14, "confirm_cnt")
    table.cell(debug_table, 1, 14, str.tostring(choch_confirm_count))
    table.cell(debug_table, 0, 15, "work_level")
    table.cell(debug_table, 1, 15, str.tostring(working_level, format.mintick))
else
    if not na(debug_table)
        table.delete(debug_table)
        debug_table := na

plot(debug_mode ? debug_flat_mid : na, "DBG Flat Mid", color=skin_working_line_col, linewidth=1, style=plot.style_line)
plot(debug_mode ? debug_poc_level : na, "DBG POC Level", color=skin_poc_line, linewidth=2, style=plot.style_line)
plot(debug_mode ? stop_price : na, "DBG Stop Price", color=skin_stop_line_col, linewidth=2, style=plot.style_line)
plot(debug_mode ? debug_pp_state : na, "DBG PP State", color=skin_choch_col, linewidth=1, style=plot.style_step)
plot(debug_mode ? debug_trap_flags : na, "DBG Trap Flags", color=skin_trap_col, linewidth=2, style=plot.style_histogram)
plot(debug_mode ? debug_rr_gate_state : na, "DBG RR Gate", color=skin_take_fill, linewidth=1, style=plot.style_columns)

// =========================
// ALERTS
// =========================
alertcondition(buy_setup or inner_buy, "Prizrak BUY", "🟢 BUY {{ticker}} {{close}}")
alertcondition(sell_setup or inner_sell, "Prizrak SELL", "🔴 SELL {{ticker}} {{close}}")
alertcondition(trap_up or trap_down, "Prizrak TRAP", "🪤 TRAP {{ticker}} {{close}}")
alertcondition(choch_active and (choch_kind == 2 or choch_kind == 4), "Prizrak PP TRUE", "🟣 PP TRUE {{ticker}} {{close}}")
alertcondition(position_active and not na(breakeven_price), "Prizrak BREAKEVEN", "⚖️ BE {{ticker}} {{close}}")
