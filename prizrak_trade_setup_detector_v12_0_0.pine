//@version=6
indicator("Prizrak Trade Setup Detector v12.2.0", overlay=true, max_boxes_count=300, max_labels_count=300)

mode_tf = input.string("AUTO", "TF mode", options=["AUTO", "MANUAL"], group="TF Hierarchy")
manual_htf1 = input.timeframe("240", "Manual HTF1", group="TF Hierarchy")
manual_htf2 = input.timeframe("60", "Manual HTF2", group="TF Hierarchy")
manual_htf3 = input.timeframe("15", "Manual HTF3", group="TF Hierarchy")
use_htf3 = input.bool(false, "Enable HTF3", group="TF Hierarchy")
manual_ltf = input.timeframe("", "Manual LTF (blank = chart)", group="TF Hierarchy")
auto_ltf_mode = input.string("AUTO_BY_CHART", "AUTO LTF mode", options=["AUTO_BY_CHART", "AUTO_BY_HTF2", "CHART"], group="TF Hierarchy")

base_len = input.int(28, "HTF base seek length", minval=8, maxval=200, group="Zone Engine • HTF")
min_base_bars = input.int(12, "HTF min base bars", minval=4, maxval=300, group="Zone Engine • HTF")
touch_tolerance = input.float(0.0025, "HTF base touch tolerance", minval=0.0005, step=0.0005, group="Zone Engine • HTF")
min_touches = input.int(4, "HTF base min touches", minval=2, maxval=20, group="Zone Engine • HTF")
max_range_atr = input.float(1.6, "HTF base max range ATR", minval=0.5, step=0.1, group="Zone Engine • HTF")
exit_confirm_bars = input.int(2, "HTF breakout confirm bars", minval=1, maxval=6, group="Zone Engine • HTF")
htf_poc_pad_mult = input.float(0.35, "HTF POC pad ATR mult", minval=0.05, step=0.05, group="Zone Engine • HTF")
htf_poc_bins = input.int(40, "HTF POC bins", minval=10, maxval=120, group="Zone Engine • HTF")
base_max_bars = input.int(300, "HTF max bars in base", minval=50, maxval=1000, group="Zone Engine • HTF")
max_zones_per_tf = input.int(8, "Max zones per TF per side", minval=1, maxval=20, group="Zone Engine • HTF")
max_age_bars = input.int(700, "Max age bars", minval=50, maxval=5000, group="Zone Engine • HTF")
consume_reaction_atr_mult = input.float(0.9, "Consume reaction ATR mult", minval=0.2, step=0.1, group="Zone Engine • HTF")
invalidate_confirm_bars = input.int(2, "Invalidate confirm bars", minval=1, maxval=5, group="Zone Engine • HTF")
invalidate_pad_atr = input.float(0.1, "Invalidate pad ATR mult", minval=0.0, step=0.05, group="Zone Engine • HTF")
flip_on_break = input.bool(true, "Flip on break + retest", group="Zone Engine • HTF")
flip_retest_bars = input.int(4, "Flip retest window (zone TF bars)", minval=1, maxval=20, group="Zone Engine • HTF")
show_consumed_history = input.bool(false, "Show consumed history", group="Zone Engine • HTF")

use_ltf_entry_gate = input.bool(true, "Use LTF entry gate", group="Zone Engine • LTF")
ltf_gate_mode = input.string("NEAR", "LTF gate mode", options=["NEAR", "IN_ZONE"], group="Zone Engine • LTF")
touch_mode = input.string("CLOSE", "Zone touch mode", options=["CLOSE", "WICK"], group="Zone Engine • LTF")
ltf_near_atr = input.float(0.35, "LTF near ATR mult", minval=0.0, step=0.05, group="Zone Engine • LTF")
ltf_poc_len = input.int(80, "LTF POC length", minval=20, maxval=500, group="Zone Engine • LTF")
ltf_poc_bins = input.int(32, "LTF POC bins", minval=8, maxval=120, group="Zone Engine • LTF")
entry_break_len = input.int(2, "LTF trigger break lookback", minval=1, maxval=8, group="Zone Engine • LTF")

near_thr_atr = input.float(1.0, "Near threshold ATR multiple", minval=0.1, step=0.1, group="Stages")
use_rr_gate = input.bool(true, "Use RR gate", group="Stages")
rr_min = input.float(3.0, "Min RR", minval=1.0, step=0.5, group="Stages")  // По методологии PrizrakTrade золотой стандарт 1:3
entry_plan_mode = input.string("POC", "Entry plan mode", options=["POC", "ZONE_EDGE"], group="Stages")
poc_proxy_mode = input.string("FAST", "POC proxy mode", options=["FAST", "EXACT"], group="Stages")
trigger_mode = input.string("STRICT_SWING", "Trigger mode", options=["LEGACY_MAX", "STRICT_SWING"], group="Stages")
countertrend_enabled = input.bool(false, "Countertrend filter", group="Stages")
countertrend_mode = input.string("IGNORE", "Countertrend action", options=["IGNORE", "PENALIZE"], group="Stages")
countertrend_penalty = input.float(0.6, "Countertrend score penalty", minval=0.0, step=0.1, group="Stages")
stop_pad_atr_mult = input.float(0.1, "Stop pad ATR mult", minval=0.0, step=0.05, group="Stages")
stop_pad_pct = input.float(0.5, "Stop pad %", minval=0.0, step=0.1, group="Stages")
stop_mode = input.string("BASE", "Stop mode", options=["BASE", "STOPVOL_NEAR"], group="Stages")
stopvol_near_pct = input.float(0.5, "StopVol near threshold %", minval=0.1, step=0.1, group="Stages")
rr_fallback_atr = input.float(3.0, "RR fallback target ATR", minval=0.5, step=0.5, group="Stages")
use_ema_bias_confirm = input.bool(true, "Use EMA_BIAS", group="Stages")
use_trap_confirm = input.bool(false, "Use TRAP", group="Stages")
osc_mode = input.string("SIMPLE", "Oscillator confirm mode", options=["OFF", "SIMPLE", "DIVERGENCE"], group="Stages")
div_left_bars = input.int(2, "Divergence pivot left bars", minval=1, maxval=8, group="Stages")
div_right_bars = input.int(2, "Divergence pivot right bars", minval=1, maxval=8, group="Stages")
div_lookback_bars = input.int(120, "Divergence lookback bars", minval=20, maxval=800, group="Stages")

pp_enabled = input.bool(true, "Enable PP confirm", group="Confirm • PP")
pp_type = input.string("BOTH", "PP type", options=["TRUE", "EARLY", "BOTH"], group="Confirm • PP")
pp_tf = input.timeframe("", "PP timeframe (blank = LTF)", group="Confirm • PP")
pp_confirm_closes = input.int(2, "PP confirm closes", minval=2, maxval=3, group="Confirm • PP")
pp_retest_window = input.int(8, "PP retest window", minval=2, maxval=30, group="Confirm • PP")

trap_max_bars = input.int(6, "Trap max bars", minval=1, maxval=20, group="Trap")
trap_use_volume_gate = input.bool(false, "Trap return volume gate (zone TF volume)", group="Trap")
trap_return_volume_mult = input.float(1.1, "Trap return vol <= MA *", minval=0.5, step=0.1, group="Trap")

stopvol_enabled = input.bool(true, "Enable stop-volume origin", group="Stop Volume")
stopvol_len = input.int(6, "Stop-volume compression length", minval=3, maxval=60, group="Stop Volume")
stopvol_exit_confirm = input.int(2, "Stop-volume breakout confirm bars", minval=1, maxval=6, group="Stop Volume")
stopvol_range_atr_mult = input.float(1.25, "Stop-volume range <= ATR *", minval=0.2, step=0.05, group="Stop Volume")
stopvol_vol_mult = input.float(1.5, "Stop-volume vol >= MA *", minval=0.5, step=0.1, group="Stop Volume")

show_hud = input.bool(true, "Show HUD", group="Visual")
ui_mode = input.string("STANDARD", "UI mode", options=["CLEAN", "STANDARD", "FULL", "DEBUG"], group="Visual")
render_mode = input.string("LAST_BAR_ONLY", "Render mode", options=["HISTORY", "LAST_BAR_ONLY"], group="Visual")
show_active_zones_only = input.bool(false, "Show active zones only", group="Visual")
show_labels = input.bool(true, "Show stage icons", group="Visual")
show_rr_lines = input.bool(true, "Show entry/stop/tp lines", group="Visual")
icon_keep = input.int(90, "Icons keep", minval=20, maxval=250, group="Visual")
zone_extend_bars = input.int(400, "Zone extend bars", minval=50, maxval=5000, group="Visual")

int Z_ACTIVE = 0
int Z_TOUCHED = 1
int Z_CONSUMED = 2
int Z_INVALID = 3
int Z_EXPIRED = 4

string STAGE_FAR = "FAR"
string STAGE_NEAR = "NEAR"
string STAGE_IN_ZONE = "IN_ZONE"
string STAGE_LTF_READY = "LTF_READY"
string STAGE_CONFIRM_READY = "CONFIRM_READY"
string STAGE_ENTRY = "ENTRY"

int BASE_SEEK = 0
int BASE_BUILD = 1
int BASE_VALID = 2
int BASE_BREAK_UP = 3
int BASE_BREAK_DN = 4
int MAX_CLEANUP_ITERATIONS = 16
int MAX_LABELS_BUDGET = 300
int BLOCK_RR = 0x01
int BLOCK_PP = 0x02
int BLOCK_TRAP = 0x04
int BLOCK_OSC = 0x08
int BLOCK_EMA = 0x10
int BLOCK_TRIG_JUMP = 0x20
float SWITCH_MARGIN_SCORE = 0.2
int SWITCH_HOLD_BARS = 3
float EPS = syminfo.mintick * 0.25

f_tf_ms(string _tf) => int(timeframe.in_seconds(_tf) * 1000)
f_clamp(int v, int lo, int hi) => math.max(lo, math.min(hi, v))
f_inside_zone(float _bot, float _top) => touch_mode == "WICK" ? (low <= _top and high >= _bot) : (close >= _bot and close <= _top)
f_calculate_poc(float _lo, float _hi, int _bins, int _bars_cap, int _src_shift, string _mode) =>
    int bins_safe = math.max(_bins, 1)
    int bars_cap_safe = math.max(_bars_cap, 1)
    float den_raw = _hi - _lo
    float den = math.max(den_raw, syminfo.mintick)
    float fallback_price = na(hlc3[_src_shift]) ? _lo : hlc3[_src_shift]
    
    // Initialize bins array only once with correct size
    var float[] bins = array.new_float(bins_safe, 0.0)
    
    // Reset bins to zero without recreating the array
    for bi = 0 to bins_safe - 1
        array.set(bins, bi, 0.0)
    
    float cum_v = 0.0
    float pv = 0.0
    float vv = 0.0
    
    // Single loop to calculate both histogram and VWAP
    for j = 0 to bars_cap_safe - 1
        int src = j + _src_shift
        float w = math.max(volume[src], 0.0)
        
        // For histogram calculation
        int idx = den_raw > EPS ? f_clamp(int(math.floor((hlc3[src] - _lo) / den * (bins_safe - 1))), 0, bins_safe - 1) : 0
        array.set(bins, idx, array.get(bins, idx) + w)
        
        // For VWAP calculation
        pv += hlc3[src] * w
        vv += w
        cum_v += w
    
    // Find max bin for fast POC
    float vmax = -1.0
    int max_idx = 0
    for bi = 0 to bins_safe - 1
        float v = array.get(bins, bi)
        if v > vmax
            vmax := v
            max_idx := bi
    
    float bw = den / bins_safe
    float poc_fast = _lo + bw * max_idx + bw * 0.5
    float poc_fast_safe = cum_v > EPS ? poc_fast : fallback_price
    float poc_vwap = vv > EPS ? pv / vv : poc_fast_safe
    _mode == "EXACT" ? poc_vwap : poc_fast_safe

f_detect_trigger(bool _has_zone, float _trig, float _entry, int _side) =>
    trigger_mode == "LEGACY_MAX" ? (_has_zone and not na(_trig)) : (_has_zone and not na(_trig) and not na(_entry) and (_side == 1 ? _trig > _entry + EPS : _trig < _entry - EPS))

f_compute_rr(float _entry, float _stop, float _tp, int _side) =>
    float risk = _side == 1 ? _entry - _stop : _stop - _entry
    float reward = _side == 1 ? _tp - _entry : _entry - _tp
    risk > EPS and reward > EPS ? reward / risk : na

f_block_hint(bool _blocked, bool _trig_ok) => _blocked ? "Следующий шаг: дождитесь подтверждённого пивота" : (_trig_ok ? "Фильтры пройдены" : "Ожидается триггер")

int tf_sec = timeframe.in_seconds()
string auto_htf1 = tf_sec <= 15 * 60 ? "240" : tf_sec <= 60 * 60 ? "D" : "W"
string auto_htf2 = tf_sec <= 15 * 60 ? "60" : tf_sec <= 60 * 60 ? "240" : "D"
string auto_htf3 = tf_sec <= 15 * 60 ? "15" : tf_sec <= 60 * 60 ? "60" : "240"
string auto_ltf_by_chart = tf_sec <= 15 * 60 ? "5" : tf_sec <= 60 * 60 ? "15" : tf_sec <= 4 * 60 * 60 ? "60" : "240"
string htf1 = mode_tf == "AUTO" ? auto_htf1 : manual_htf1
string htf2 = mode_tf == "AUTO" ? auto_htf2 : manual_htf2
string htf3 = mode_tf == "AUTO" ? auto_htf3 : manual_htf3
string ltf_auto = auto_ltf_mode == "AUTO_BY_HTF2" ? (timeframe.in_seconds(htf2) <= 60 * 60 ? "5" : "15") : auto_ltf_by_chart
string ltf_raw = mode_tf == "AUTO" ? (auto_ltf_mode == "CHART" ? timeframe.period : ltf_auto) : (str.length(manual_ltf) > 0 ? manual_ltf : timeframe.period)
int ltf_raw_sec = timeframe.in_seconds(ltf_raw)
bool ltf_below_chart = not na(ltf_raw_sec) and ltf_raw_sec < tf_sec
string ltf = ltf_below_chart ? timeframe.period : ltf_raw
float htf1_sec = timeframe.in_seconds(htf1)
float htf2_sec = timeframe.in_seconds(htf2)
float htf3_sec = timeframe.in_seconds(htf3)
bool htf_order_ok = not na(htf1_sec) and not na(htf2_sec) and (not use_htf3 or not na(htf3_sec)) and htf1_sec > htf2_sec and (not use_htf3 or htf2_sec > htf3_sec)
string pp_tf_eff = str.length(pp_tf) > 0 ? pp_tf : ltf

if base_len < min_base_bars
    runtime.error("base_len must be >= min_base_bars")
if mode_tf == "MANUAL" and (str.length(manual_htf1) == 0 or str.length(manual_htf2) == 0)
    runtime.error("MANUAL mode requires both HTF1 and HTF2")
if max_zones_per_tf < 1 or max_zones_per_tf > 20
    runtime.error("max_zones_per_tf must be in [1..20]")

f_htf_pack(int _seek_len, int _min_base_bars, float _tol, int _min_touches, float _max_range_atr, int _exit_confirm, int _bins, int _base_max_bars) =>
    float atr = ta.atr(14)
    float vol_ma = ta.sma(volume, 20)
    float trend_dir = ta.ema(close, 21) > ta.ema(close, 55) ? 1.0 : -1.0
    var int st = BASE_SEEK
    var float base_hi = na
    var float base_lo = na
    var int base_bars = 0
    var int touches_hi = 0
    var int touches_lo = 0
    var bool in_hi_band_prev = false
    var bool in_lo_band_prev = false
    var int out_up = 0
    var int out_dn = 0
    var float poc = na
    var float b_hi = na
    var float b_lo = na
    bool edge_up = false
    bool edge_dn = false

    var bool in_stop = false
    var float stop_hi = na
    var float stop_lo = na
    var int stop_exit_cnt = 0
    bool stop_edge_up = false
    bool stop_edge_dn = false
    float stop_poc = na
    float stop_bhi = na
    float stop_blo = na

    if st == BASE_SEEK
        float span_hi = ta.highest(high, _seek_len)
        float span_lo = ta.lowest(low, _seek_len)
        if (span_hi - span_lo) <= atr * _max_range_atr
            st := BASE_BUILD
            base_hi := high
            base_lo := low
            base_bars := 1
            touches_hi := 0
            touches_lo := 0
            out_up := 0
            out_dn := 0
            in_hi_band_prev := false
            in_lo_band_prev := false

    if st == BASE_BUILD or st == BASE_VALID
        float tol_abs = math.max(_tol * close, atr * 0.05)
        float prev_hi = base_hi
        float prev_lo = base_lo
        bool hi_touch = high >= prev_hi - tol_abs
        bool lo_touch = low <= prev_lo + tol_abs
        if hi_touch and not in_hi_band_prev
            touches_hi += 1
        if lo_touch and not in_lo_band_prev
            touches_lo += 1
        in_hi_band_prev := hi_touch
        in_lo_band_prev := lo_touch

        bool is_break_up = close > prev_hi
        bool is_break_dn = close < prev_lo
        bool is_break_bar = is_break_up or is_break_dn

        if st == BASE_VALID
            out_up := is_break_up ? out_up + 1 : 0
            out_dn := is_break_dn ? out_dn + 1 : 0

        if not is_break_bar
            base_hi := math.max(base_hi, high)
            base_lo := math.min(base_lo, low)
            base_bars += 1
        float range_hi = is_break_bar ? prev_hi : base_hi
        float range_lo = is_break_bar ? prev_lo : base_lo
        float base_range = range_hi - range_lo

        bool valid_now = base_bars >= _min_base_bars and touches_hi >= _min_touches and touches_lo >= _min_touches and base_range <= atr * _max_range_atr
        if st == BASE_BUILD and valid_now
            st := BASE_VALID

        if base_range > atr * (_max_range_atr * 1.3) or base_bars > _base_max_bars
            st := BASE_SEEK

        if st == BASE_VALID and (out_up >= _exit_confirm or out_dn >= _exit_confirm)
                edge_up := out_up >= _exit_confirm
                edge_dn := out_dn >= _exit_confirm
                st := edge_up ? BASE_BREAK_UP : BASE_BREAK_DN
                b_hi := prev_hi
                b_lo := prev_lo
                int bars_cap = math.max(math.min(base_bars, _base_max_bars), 1)
                int break_span = math.max(out_up, out_dn)
                poc := f_calculate_poc(b_lo, b_hi, _bins, bars_cap, break_span, poc_proxy_mode)

    if st == BASE_BREAK_UP or st == BASE_BREAK_DN
        st := BASE_SEEK
        base_hi := na
        base_lo := na
        base_bars := 0
        touches_hi := 0
        touches_lo := 0
        out_up := 0
        out_dn := 0

    float s_hi = ta.highest(high, stopvol_len)
    float s_lo = ta.lowest(low, stopvol_len)
    float s_rng = s_hi - s_lo
    float s_vol_sum = math.sum(volume, stopvol_len)
    bool stop_rng_ok = s_rng <= atr * stopvol_range_atr_mult
    bool stop_vol_ok = not na(vol_ma) and s_vol_sum >= vol_ma * stopvol_vol_mult * stopvol_len
    if stopvol_enabled and not in_stop and bar_index >= stopvol_len and stop_rng_ok and stop_vol_ok
        in_stop := true
        stop_hi := s_hi
        stop_lo := s_lo
        stop_exit_cnt := 0

    if in_stop
        bool stop_out_up = close > stop_hi
        bool stop_out_dn = close < stop_lo
        bool stop_out = stop_out_up or stop_out_dn
        stop_exit_cnt := stop_out ? stop_exit_cnt + 1 : 0
        if stop_exit_cnt >= stopvol_exit_confirm
            stop_edge_up := stop_out_up
            stop_edge_dn := stop_out_dn
            stop_bhi := stop_hi
            stop_blo := stop_lo
            int stop_cap = math.max(math.min(stopvol_len, _base_max_bars), 1)
            int stop_break_span = stopvol_exit_confirm
            stop_poc := f_calculate_poc(stop_lo, stop_hi, _bins, stop_cap, stop_break_span, poc_proxy_mode)
            in_stop := false
            stop_hi := na
            stop_lo := na
            stop_exit_cnt := 0

    [edge_up ? 1.0 : 0.0, edge_dn ? 1.0 : 0.0, atr, b_hi, b_lo, poc, time * 1.0, close, open, high, low, volume, vol_ma, stop_edge_up ? 1.0 : 0.0, stop_edge_dn ? 1.0 : 0.0, stop_poc, stop_bhi, stop_blo, ta.highest(high, trap_max_bars) - ta.lowest(low, trap_max_bars), trend_dir]

// Функция безопасного MTF-запроса (защита от репайнтинга в replay)
f_safe_security(string _tf, _expression) =>
    int tf_ms = timeframe.in_seconds(_tf) * 1000
    int request_time = barstate.isconfirmed ? time : time - tf_ms
    request.security(syminfo.tickerid, _tf, _expression, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

[htf1_edge_up, htf1_edge_dn, htf1_atr, htf1_bh, htf1_bl, htf1_poc, htf1_timef, htf1_close, htf1_open, htf1_high, htf1_low, htf1_vol, htf1_vol_ma, htf1_stop_up, htf1_stop_dn, htf1_stop_poc, htf1_stop_bh, htf1_stop_bl, htf1_trap_range, htf1_trend_dir] = f_safe_security(htf1, f_htf_pack(base_len, min_base_bars, touch_tolerance, min_touches, max_range_atr, exit_confirm_bars, htf_poc_bins, base_max_bars))
[htf2_edge_up, htf2_edge_dn, htf2_atr, htf2_bh, htf2_bl, htf2_poc, htf2_timef, htf2_close, htf2_open, htf2_high, htf2_low, htf2_vol, htf2_vol_ma, htf2_stop_up, htf2_stop_dn, htf2_stop_poc, htf2_stop_bh, htf2_stop_bl, htf2_trap_range, htf2_trend_dir] = f_safe_security(htf2, f_htf_pack(base_len, min_base_bars, touch_tolerance, min_touches, max_range_atr, exit_confirm_bars, htf_poc_bins, base_max_bars))

[htf3_edge_up, htf3_edge_dn, htf3_atr, htf3_bh, htf3_bl, htf3_poc, htf3_timef, htf3_close, htf3_open, htf3_high, htf3_low, htf3_vol, htf3_vol_ma, htf3_stop_up, htf3_stop_dn, htf3_stop_poc, htf3_stop_bh, htf3_stop_bl, htf3_trap_range, htf3_trend_dir] = use_htf3 ? f_safe_security(htf3, f_htf_pack(base_len, min_base_bars, touch_tolerance, min_touches, max_range_atr, exit_confirm_bars, htf_poc_bins, base_max_bars)) : na
plot(htf1_edge_up, "DBG htf1_edge_up", color=color.new(color.green, 100), display=display.data_window)
plot(htf1_edge_dn, "DBG htf1_edge_dn", color=color.new(color.red, 100), display=display.data_window)
plot(htf2_edge_up, "DBG htf2_edge_up", color=color.new(color.green, 100), display=display.data_window)
plot(htf2_edge_dn, "DBG htf2_edge_dn", color=color.new(color.red, 100), display=display.data_window)

f_ltf_pack(int _len, int _bins, int _break_len) =>
    float atr = ta.atr(14)
    float ph = ta.highest(high, _len)
    float pl = ta.lowest(low, _len)
    int bins_safe = math.max(_bins, 1)
    float den = ph - pl
    
    // Initialize bins array only once with correct size
    var float[] bins = array.new_float(bins_safe, 0.0)
    
    // Reset bins to zero without recreating the array
    for bi = 0 to bins_safe - 1
        array.set(bins, bi, 0.0)
    
    float cum_v = 0.0
    
    // Single loop to calculate histogram
    for j = 0 to _len - 1
        int idx = den > EPS ? f_clamp(int(math.floor((hlc3[j] - pl) / den * (bins_safe - 1))), 0, bins_safe - 1) : 0
        float vsrc = math.max(volume[j], 0.0)
        cum_v += vsrc
        array.set(bins, idx, array.get(bins, idx) + vsrc)
    
    float vmax = -1.0
    int max_idx = 0
    
    // Find max bin for POC
    for bi = 0 to bins_safe - 1
        float vv = array.get(bins, bi)
        if vv > vmax
            vmax := vv
            max_idx := bi
    
    float bw = den > EPS ? den / bins_safe : 0.0
    float poc = den > EPS and cum_v > EPS ? pl + bw * max_idx + bw * 0.5 : hlc3
    int break_len_safe = math.max(_break_len, 1)
    float trig_up_prev = ta.highest(high, break_len_safe)[1]
    float trig_dn_prev = ta.lowest(low, break_len_safe)[1]
    [atr, poc, trig_up_prev, trig_dn_prev, close, time * 1.0]

[ltf_atr, ltf_poc, ltf_trig_up, ltf_trig_dn, ltf_close, ltf_timef] = request.security(syminfo.tickerid, ltf, f_ltf_pack(ltf_poc_len, ltf_poc_bins, entry_break_len), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// Функция детекции прокола (fakeout) - цена вышла и вернулась за 1-2 свечи
f_is_fakeout(float _level, bool _is_upper) =>
    bool broke = _is_upper ? high > _level : low < _level
    bool closed_inside = _is_upper ? close <= _level : close >= _level
    bool prev_closed_inside = _is_upper ? close[1] <= _level : close[1] >= _level
    broke and closed_inside and prev_closed_inside

// Функция детекции пробоя (breakout) - закрепление за уровнем
f_is_breakout(float _level, bool _is_upper, int _confirm_bars) =>
    bool beyond = _is_upper ? close > _level : close < _level
    bool prev_beyond = _is_upper ? close[1] > _level : close[1] < _level
    beyond and prev_beyond and barssince(beyond) >= _confirm_bars

f_pp_pack(int _cc, int _rw) =>
    var float last_sh = na
    var float last_sl = na
    var int bull_break = na
    var int bear_break = na
    var float bull_lvl = na
    var float bear_lvl = na
    var bool bull_ok = false
    var bool bear_ok = false
    var int closes_beyond = 0  // НОВОЕ: счётчик закрывшихся свечей за уровнем
    
    // Сброс счётчика при изменении направления
    if not na(bull_break) and close <= bull_lvl
        closes_beyond := 0
    if not na(bear_break) and close >= bear_lvl
        closes_beyond := 0
    
    // Подсчёт закрывшихся свечей за уровнем
    if not na(bull_break) and close > bull_lvl
        closes_beyond := closes_beyond + 1
    if not na(bear_break) and close < bear_lvl
        closes_beyond := closes_beyond + 1
    
    // Истинный ПП требует подтверждения 2-3 свечами
    bool true_pp_confirm = closes_beyond >= _cc
    float ph = ta.pivothigh(high, 2, 2)
    float pl = ta.pivotlow(low, 2, 2)
    if not na(ph)
        last_sh := ph
    if not na(pl)
        last_sl := pl
    if not na(last_sh) and close > last_sh
        bull_break := bar_index
        bull_lvl := last_sh
        bull_ok := false
    if not na(last_sl) and close < last_sl
        bear_break := bar_index
        bear_lvl := last_sl
        bear_ok := false
    bool bull_retest = not na(bull_break) and bar_index - bull_break <= _rw and low <= bull_lvl and close >= bull_lvl
    bool bear_retest = not na(bear_break) and bar_index - bear_break <= _rw and high >= bear_lvl and close <= bear_lvl
    bool bull_bodies = close > bull_lvl and close[1] > bull_lvl and (_cc == 2 or close[2] > bull_lvl)
    bool bear_bodies = close < bear_lvl and close[1] < bear_lvl and (_cc == 2 or close[2] < bear_lvl)
    if bull_retest and bull_bodies
        bull_ok := true
    if bear_retest and bear_bodies
        bear_ok := true
    float early_bull_lvl = ta.highest(high, 5)[1]
    float early_bear_lvl = ta.lowest(low, 5)[1]
    bool eb = close > early_bull_lvl and close[1] <= early_bull_lvl
    bool es = close < early_bear_lvl and close[1] >= early_bear_lvl
    bool early_bull_ok = eb and low <= early_bull_lvl and close >= early_bull_lvl
    bool early_bear_ok = es and high >= early_bear_lvl and close <= early_bear_lvl
    float bull_state = bull_ok ? 1.0 : (not na(bull_break) and bar_index - bull_break <= _rw ? 0.0 : -1.0)
    float bear_state = bear_ok ? 1.0 : (not na(bear_break) and bar_index - bear_break <= _rw ? 0.0 : -1.0)
    [bull_state, bear_state, early_bull_ok ? 1.0 : 0.0, early_bear_ok ? 1.0 : 0.0]

[pp_true_buy_state, pp_true_sell_state, pp_early_buy_okf, pp_early_sell_okf] = request.security(syminfo.tickerid, pp_tf_eff, f_pp_pack(pp_confirm_closes, pp_retest_window), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

type Zone
    int id
    int typ
    int status
    string tf
    float top
    float bot
    float poc
    float atr
    int time
    int touch
    int reactionCount      // НОВОЕ: счётчик полноценных реакций
    bool inside_prev
    int inv_cnt
    int last_tf_time
    int tf_seq
    int break_seq
    float base_hi
    float base_lo
    int break_time
    string origin
    int touch_bar
    float react_hi
    float react_lo
    bool isWeak            // НОВОЕ: флаг "ослабленного" уровня после первой реакции
    box box_id
    label label_id

var Zone[] zones = array.new<Zone>()
var int zid_seq = 0
var label[] event_icons = array.new_label()
var int active_buy_zone_id = na
var int active_sell_zone_id = na
var int active_buy_held_bars = 0
var int active_sell_held_bars = 0

int zone_labels = array.size(zones)
int label_overhead = 4
int allowed_icons = math.max(0, MAX_LABELS_BUDGET - zone_labels - label_overhead)
int icon_keep_eff = math.min(icon_keep, allowed_icons)


bool ui_clean = ui_mode == "CLEAN"
bool ui_standard = ui_mode == "STANDARD"
bool ui_full = ui_mode == "FULL"
bool ui_debug = ui_mode == "DEBUG"
bool draw_last_only = render_mode == "LAST_BAR_ONLY"
bool draw_now = not draw_last_only or barstate.islast
bool icons_budget_disabled = allowed_icons == 0
bool show_labels_eff = show_labels and not ui_clean and not icons_budget_disabled
bool show_rr_lines_eff = show_rr_lines and (ui_full or ui_debug)
bool show_consumed_eff = show_consumed_history and (ui_full or ui_debug)

f_push_icon(string _txt, color _bg, bool _up) =>
    label ic = label.new(time, close, _txt, xloc=xloc.bar_time, style=_up ? label.style_label_up : label.style_label_down, color=_bg, textcolor=color.white, size=size.tiny)
    array.push(event_icons, ic)
    while array.size(event_icons) > icon_keep_eff
        label old = array.shift(event_icons)
        if not na(old)
            label.delete(old)

f_clear_icons() =>
    while array.size(event_icons) > 0
        label old = array.shift(event_icons)
        if not na(old)
            label.delete(old)

f_zone_add(int _type, string _tf, float _poc, float _atr, int _t, float _bhi, float _blo, string _origin) =>
    zid_seq += 1
    float pad = _atr * htf_poc_pad_mult
    float top = _poc + pad
    float bot = _poc - pad
    bool is_stopvol = _origin == "STOPVOL"
    color col = _type == 1 ? (is_stopvol ? color.teal : color.green) : (is_stopvol ? color.purple : color.red)
    int opa = _tf == htf1 ? 82 : 90
    box b = box.new(_t, top, time + f_tf_ms(_tf) * zone_extend_bars, bot, xloc=xloc.bar_time, bgcolor=color.new(col, opa), border_color=color.new(col, 0), border_width=is_stopvol ? 2 : 1)
    label lb = label.new(_t, _type == 1 ? bot : top, (_type == 1 ? "BUY" : "SELL") + " POC (" + _tf + ") [" + _origin + "]", xloc=xloc.bar_time, textcolor=color.white, color=color.new(col, 20), size=size.tiny, style=label.style_label_left)
    Zone z = Zone.new(zid_seq, _type, Z_ACTIVE, _tf, top, bot, _poc, _atr, _t, 0, false, 0, _t, 0, na, _bhi, _blo, na, _origin, na, na, na, b, lb)
    array.push(zones, z)

f_zone_remove(int i) =>
    Zone z = array.get(zones, i)
    box b = z.box_id
    label lb = z.label_id
    if not na(b)
        box.delete(b)
    if not na(lb)
        label.delete(lb)
    array.remove(zones, i)

f_zone_update_visual(int i, bool _draw_now) =>
    Zone z = array.get(zones, i)
    if not na(z.box_id) and _draw_now
        box.set_right(z.box_id, time + f_tf_ms(z.tf) * zone_extend_bars)
        bool show_zone = not show_active_zones_only or z.status <= Z_TOUCHED
        box.set_bgcolor(z.box_id, show_zone ? box.get_bgcolor(z.box_id) : color.new(color.black, 100))

f_zone_update_lifecycle(int i, bool _draw_now) =>
    bool consumed_evt = false
    bool invalid_evt = false
    bool flip_armed_evt = false
    bool flipped_evt = false
    bool flip_expired_evt = false
    bool removed = false
    Zone z = array.get(zones, i)
    int st = z.status
    int htime = int(z.tf == htf1 ? htf1_timef : htf2_timef)
    float hclose = z.tf == htf1 ? htf1_close : htf2_close
    float hhigh = z.tf == htf1 ? htf1_high : htf2_high
    float hlow = z.tf == htf1 ? htf1_low : htf2_low

    bool inside = f_inside_zone(z.bot, z.top)
    if inside and not z.inside_prev and st <= Z_TOUCHED
        z.touch += 1
        z.status := Z_TOUCHED
        z.touch_bar := bar_index
        z.react_hi := high
        z.react_lo := low
    z.inside_prev := inside

    if z.status <= Z_TOUCHED and z.touch >= 1
        z.react_hi := na(z.react_hi) ? high : math.max(z.react_hi, high)
        z.react_lo := na(z.react_lo) ? low : math.min(z.react_lo, low)

    bool touch_window_live = not na(z.touch_bar) and bar_index > z.touch_bar
    if z.touch >= 1 and st <= Z_TOUCHED and touch_window_live
        // Проверка сильной реакции для подсчёта reactionCount
        bool strong_reaction = z.typ == 1 ? (z.react_hi - z.top) >= z.atr * 0.5 : (z.bot - z.react_lo) >= z.atr * 0.5
        if strong_reaction and z.reactionCount == 0
            z.reactionCount := 1
            z.isWeak := true  // Уровень помечается как слабый после первой реакции
        
        bool consumed_now = z.typ == 1 ? (z.react_hi - z.top) >= z.atr * consume_reaction_atr_mult : (z.bot - z.react_lo) >= z.atr * consume_reaction_atr_mult
        if consumed_now
            z.status := Z_CONSUMED
            consumed_evt := true

    float inv_pad = z.atr * invalidate_pad_atr
    bool inv_body = z.typ == 1 ? hclose < z.bot - inv_pad : hclose > z.top + inv_pad
    if htime != z.last_tf_time
        z.inv_cnt := inv_body ? z.inv_cnt + 1 : 0
        z.last_tf_time := htime
        z.tf_seq += 1
    if z.inv_cnt >= invalidate_confirm_bars and st <= Z_TOUCHED
        z.status := Z_INVALID
        z.break_time := htime
        z.break_seq := z.tf_seq
        invalid_evt := true
        if flip_on_break
            flip_armed_evt := true

    if flip_on_break and z.status == Z_INVALID
        bool in_win = not na(z.break_seq) and (z.tf_seq - z.break_seq) <= flip_retest_bars
        bool retest_ok = z.typ == 1 ? hhigh >= z.bot and hclose <= z.bot : hlow <= z.top and hclose >= z.top
        if in_win and retest_ok
            f_zone_add(-z.typ, z.tf, z.poc, z.atr, htime, z.base_hi, z.base_lo, z.origin)
            flipped_evt := true
            z.break_time := na
            z.break_seq := na
        else if not in_win
            flip_expired_evt := true

    if z.tf_seq > max_age_bars and z.status <= Z_TOUCHED
        z.status := Z_EXPIRED

    bool keep = z.status == Z_ACTIVE or z.status == Z_TOUCHED or (show_consumed_eff and z.status == Z_CONSUMED) or (flip_on_break and z.status == Z_INVALID and not flip_expired_evt and not flipped_evt)
    if not keep
        f_zone_remove(i)
        removed := true
    else
        array.set(zones, i, z)
        f_zone_update_visual(i, _draw_now)
    [consumed_evt, invalid_evt, flip_armed_evt, flipped_evt, flip_expired_evt, removed]

f_zone_htf_dir(string _tf) =>
    _tf == htf1 ? htf1_trend_dir : _tf == htf2 ? htf2_trend_dir : _tf == htf3 ? htf3_trend_dir : na

f_is_countertrend(string _tf, int _side) =>
    float dir = f_zone_htf_dir(_tf)
    not na(dir) and (_side == 1 ? dir < 0 : dir > 0)
f_find_zone_index(int _zone_id) =>
    int idx = -1
    for j = 0 to array.size(zones) - 1
        if array.get(zones, j).id == _zone_id
            idx := j
            break
    idx

f_is_zone_selectable(int i) =>
    array.get(zones, i).status <= Z_TOUCHED

f_zone_score(int i) =>
    Zone z = array.get(zones, i)
    float top = z.top
    float bot = z.bot
    float atrz = z.atr
    float dist = close > top ? close - top : close < bot ? bot - close : 0.0
    float dist_norm = dist / math.max(atrz, syminfo.mintick)
    float tf_penalty = z.tf == htf1 ? 0.0 : z.tf == htf2 ? 0.35 : 0.55
    float ct_penalty = countertrend_enabled and countertrend_mode == "PENALIZE" and f_is_countertrend(z.tf, z.typ) ? countertrend_penalty : 0.0
    dist_norm + tf_penalty + ct_penalty

f_enforce_tf_side_limit(int _typ, string _tf) =>
    int keep = max_zones_per_tf
    int count = 0
    for j = 0 to array.size(zones) - 1
        Zone z = array.get(zones, j)
        if z.typ == _typ and z.tf == _tf
            count += 1
    while count > keep
        int oldest_idx = -1
        int oldest_time = int(10e15)
        for j = 0 to array.size(zones) - 1
            Zone z = array.get(zones, j)
            if z.typ == _typ and z.tf == _tf
                int zt = z.time
                if zt < oldest_time
                    oldest_time := zt
                    oldest_idx := j
        if oldest_idx >= 0
            f_zone_remove(oldest_idx)
            count -= 1
        else
            break

f_zone_select_active(int _side) =>
    int best_idx = -1
    float best_score = 10e10
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        bool blocked_counter = countertrend_enabled and countertrend_mode == "IGNORE" and f_is_countertrend(z.tf, _side)
        if z.typ == _side and f_is_zone_selectable(i) and not blocked_counter
            float score = f_zone_score(i)
            if score < best_score
                best_score := score
                best_idx := i
    best_idx

f_zone_prune_limits() =>
    int tf_slots = use_htf3 ? 6 : 4
    int cleanup_iterations = 0
    while array.size(zones) > max_zones_per_tf * tf_slots and cleanup_iterations < MAX_CLEANUP_ITERATIONS
        f_zone_remove(0)
        cleanup_iterations += 1

bool zone_created = false
bool zone_invalidated = false
bool zone_consumed = false
bool flip_armed = false
bool zone_flipped = false
bool flip_expired = false

// Добавлена проверка na() для всех HTF-переменных
if not na(htf1_stop_up) and not na(htf1_atr) and not na(htf1_stop_poc) and htf1_stop_up > 0 and htf1_stop_up[1] <= 0
    f_zone_add(1, htf1, htf1_stop_poc, htf1_atr, int(htf1_timef), htf1_stop_bh, htf1_stop_bl, "STOPVOL")
    zone_created := true
else if not na(htf1_edge_up) and not na(htf1_atr) and not na(htf1_poc) and htf1_edge_up > 0 and htf1_edge_up[1] <= 0
    f_zone_add(1, htf1, htf1_poc, htf1_atr, int(htf1_timef), htf1_bh, htf1_bl, "BASE")
    zone_created := true
if not na(htf1_stop_dn) and not na(htf1_atr) and not na(htf1_stop_poc) and htf1_stop_dn > 0 and htf1_stop_dn[1] <= 0
    f_zone_add(-1, htf1, htf1_stop_poc, htf1_atr, int(htf1_timef), htf1_stop_bh, htf1_stop_bl, "STOPVOL")
    zone_created := true
else if not na(htf1_edge_dn) and not na(htf1_atr) and not na(htf1_poc) and htf1_edge_dn > 0 and htf1_edge_dn[1] <= 0
    f_zone_add(-1, htf1, htf1_poc, htf1_atr, int(htf1_timef), htf1_bh, htf1_bl, "BASE")
    zone_created := true
if not na(htf2_stop_up) and not na(htf2_atr) and not na(htf2_stop_poc) and htf2_stop_up > 0 and htf2_stop_up[1] <= 0
    f_zone_add(1, htf2, htf2_stop_poc, htf2_atr, int(htf2_timef), htf2_stop_bh, htf2_stop_bl, "STOPVOL")
    zone_created := true
else if not na(htf2_edge_up) and not na(htf2_atr) and not na(htf2_poc) and htf2_edge_up > 0 and htf2_edge_up[1] <= 0
    f_zone_add(1, htf2, htf2_poc, htf2_atr, int(htf2_timef), htf2_bh, htf2_bl, "BASE")
    zone_created := true
if not na(htf2_stop_dn) and not na(htf2_atr) and not na(htf2_stop_poc) and htf2_stop_dn > 0 and htf2_stop_dn[1] <= 0
    f_zone_add(-1, htf2, htf2_stop_poc, htf2_atr, int(htf2_timef), htf2_stop_bh, htf2_stop_bl, "STOPVOL")
    zone_created := true
else if not na(htf2_edge_dn) and not na(htf2_atr) and not na(htf2_poc) and htf2_edge_dn > 0 and htf2_edge_dn[1] <= 0
    f_zone_add(-1, htf2, htf2_poc, htf2_atr, int(htf2_timef), htf2_bh, htf2_bl, "BASE")
    zone_created := true
if use_htf3 and not na(htf3_stop_up) and not na(htf3_atr) and not na(htf3_stop_poc) and htf3_stop_up > 0 and htf3_stop_up[1] <= 0
    f_zone_add(1, htf3, htf3_stop_poc, htf3_atr, int(htf3_timef), htf3_stop_bh, htf3_stop_bl, "STOPVOL")
    zone_created := true
else if use_htf3 and not na(htf3_edge_up) and not na(htf3_atr) and not na(htf3_poc) and htf3_edge_up > 0 and htf3_edge_up[1] <= 0
    f_zone_add(1, htf3, htf3_poc, htf3_atr, int(htf3_timef), htf3_bh, htf3_bl, "BASE")
    zone_created := true
if use_htf3 and not na(htf3_stop_dn) and not na(htf3_atr) and not na(htf3_stop_poc) and htf3_stop_dn > 0 and htf3_stop_dn[1] <= 0
    f_zone_add(-1, htf3, htf3_stop_poc, htf3_atr, int(htf3_timef), htf3_stop_bh, htf3_stop_bl, "STOPVOL")
    zone_created := true
else if use_htf3 and not na(htf3_edge_dn) and not na(htf3_atr) and not na(htf3_poc) and htf3_edge_dn > 0 and htf3_edge_dn[1] <= 0
    f_zone_add(-1, htf3, htf3_poc, htf3_atr, int(htf3_timef), htf3_bh, htf3_bl, "BASE")
    zone_created := true

for i = array.size(zones) - 1 to 0
    [consumed_evt, invalid_evt, flip_armed_evt, flipped_evt, flip_expired_evt, removed_evt] = f_zone_update_lifecycle(i, draw_now)
    zone_consumed := zone_consumed or consumed_evt
    zone_invalidated := zone_invalidated or invalid_evt
    flip_armed := flip_armed or flip_armed_evt
    zone_flipped := zone_flipped or flipped_evt
    flip_expired := flip_expired or flip_expired_evt

f_zone_prune_limits()

f_enforce_tf_side_limit(1, htf1)
f_enforce_tf_side_limit(1, htf2)
if use_htf3
    f_enforce_tf_side_limit(1, htf3)
f_enforce_tf_side_limit(-1, htf1)
f_enforce_tf_side_limit(-1, htf2)
if use_htf3
    f_enforce_tf_side_limit(-1, htf3)

int best_buy_idx = f_zone_select_active(1)
int best_sell_idx = f_zone_select_active(-1)

int buy_idx = f_find_zone_index(active_buy_zone_id)
int sell_idx = f_find_zone_index(active_sell_zone_id)

if buy_idx < 0 or not f_is_zone_selectable(buy_idx)
    active_buy_zone_id := na
    active_buy_held_bars := 0
    buy_idx := -1
if sell_idx < 0 or not f_is_zone_selectable(sell_idx)
    active_sell_zone_id := na
    active_sell_held_bars := 0
    sell_idx := -1

if best_buy_idx >= 0
    if na(active_buy_zone_id)
        active_buy_zone_id := array.get(zones, best_buy_idx).id
        active_buy_held_bars := 0
    else
        int current_buy_idx = f_find_zone_index(active_buy_zone_id)
        if current_buy_idx >= 0
            float current_buy_score = f_zone_score(current_buy_idx)
            float candidate_buy_score = f_zone_score(best_buy_idx)
            bool same_zone_buy = array.get(zones, current_buy_idx).id == array.get(zones, best_buy_idx).id
            bool better_buy = candidate_buy_score + SWITCH_MARGIN_SCORE < current_buy_score
            if same_zone_buy
                active_buy_held_bars += 1
            else if better_buy and active_buy_held_bars >= SWITCH_HOLD_BARS
                active_buy_zone_id := array.get(zones, best_buy_idx).id
                active_buy_held_bars := 0
            else
                active_buy_held_bars += 1
        else
            active_buy_zone_id := array.get(zones, best_buy_idx).id
            active_buy_held_bars := 0

if best_sell_idx >= 0
    if na(active_sell_zone_id)
        active_sell_zone_id := array.get(zones, best_sell_idx).id
        active_sell_held_bars := 0
    else
        int current_sell_idx = f_find_zone_index(active_sell_zone_id)
        if current_sell_idx >= 0
            float current_sell_score = f_zone_score(current_sell_idx)
            float candidate_sell_score = f_zone_score(best_sell_idx)
            bool same_zone_sell = array.get(zones, current_sell_idx).id == array.get(zones, best_sell_idx).id
            bool better_sell = candidate_sell_score + SWITCH_MARGIN_SCORE < current_sell_score
            if same_zone_sell
                active_sell_held_bars += 1
            else if better_sell and active_sell_held_bars >= SWITCH_HOLD_BARS
                active_sell_zone_id := array.get(zones, best_sell_idx).id
                active_sell_held_bars := 0
            else
                active_sell_held_bars += 1
        else
            active_sell_zone_id := array.get(zones, best_sell_idx).id
            active_sell_held_bars := 0

buy_idx := f_find_zone_index(active_buy_zone_id)
sell_idx := f_find_zone_index(active_sell_zone_id)

float buy_dist = buy_idx >= 0 ? (close > array.get(zones, buy_idx).top ? close - array.get(zones, buy_idx).top : close < array.get(zones, buy_idx).bot ? array.get(zones, buy_idx).bot - close : 0.0) : na
float sell_dist = sell_idx >= 0 ? (close > array.get(zones, sell_idx).top ? close - array.get(zones, sell_idx).top : close < array.get(zones, sell_idx).bot ? array.get(zones, sell_idx).bot - close : 0.0) : na

bool has_buy = buy_idx >= 0
bool has_sell = sell_idx >= 0
float buy_top = has_buy ? array.get(zones, buy_idx).top : na
float buy_bot = has_buy ? array.get(zones, buy_idx).bot : na
float buy_poc = has_buy ? array.get(zones, buy_idx).poc : na
float buy_atr = has_buy ? array.get(zones, buy_idx).atr : na
float sell_top = has_sell ? array.get(zones, sell_idx).top : na
float sell_bot = has_sell ? array.get(zones, sell_idx).bot : na
float sell_poc = has_sell ? array.get(zones, sell_idx).poc : na
float sell_atr = has_sell ? array.get(zones, sell_idx).atr : na
string buy_origin = has_buy ? array.get(zones, buy_idx).origin : "-"
string sell_origin = has_sell ? array.get(zones, sell_idx).origin : "-"

bool buy_wick_touch = has_buy and high >= buy_bot and low <= buy_top
bool sell_wick_touch = has_sell and high >= sell_bot and low <= sell_top
bool buy_in_zone = has_buy and f_inside_zone(buy_bot, buy_top)
bool sell_in_zone = has_sell and f_inside_zone(sell_bot, sell_top)
bool buy_near = has_buy and buy_dist <= near_thr_atr * buy_atr
bool sell_near = has_sell and sell_dist <= near_thr_atr * sell_atr
bool ltf_gate_ok_buy = has_buy and (not use_ltf_entry_gate or (ltf_gate_mode == "IN_ZONE" ? buy_in_zone : buy_near or (buy_dist <= ltf_near_atr * ltf_atr)))
bool ltf_gate_ok_sell = has_sell and (not use_ltf_entry_gate or (ltf_gate_mode == "IN_ZONE" ? sell_in_zone : sell_near or (sell_dist <= ltf_near_atr * ltf_atr)))

float ema_fast = ta.ema(close, 21)
float ema_slow = ta.ema(close, 55)
bool ema_bias_ok_buy = not use_ema_bias_confirm or ema_fast > ema_slow
bool ema_bias_ok_sell = not use_ema_bias_confirm or ema_fast < ema_slow

float macd = ta.ema(close, 12) - ta.ema(close, 26)
float signal = ta.ema(macd, 9)
float rsi = ta.rsi(close, 14)
float div_pl = ta.pivotlow(low, div_left_bars, div_right_bars)
float div_ph = ta.pivothigh(high, div_left_bars, div_right_bars)
var float div_prev_price_low = na
var float div_last_price_low = na
var float div_prev_rsi_low = na
var float div_last_rsi_low = na
var float div_prev_macd_low = na
var float div_last_macd_low = na
var int div_prev_low_bar = na
var int div_last_low_bar = na
var float div_prev_price_high = na
var float div_last_price_high = na
var float div_prev_rsi_high = na
var float div_last_rsi_high = na
var float div_prev_macd_high = na
var float div_last_macd_high = na
var int div_prev_high_bar = na
var int div_last_high_bar = na
if not na(div_pl)
    div_prev_price_low := div_last_price_low
    div_prev_rsi_low := div_last_rsi_low
    div_prev_macd_low := div_last_macd_low
    div_prev_low_bar := div_last_low_bar
    div_last_price_low := div_pl
    div_last_rsi_low := rsi[div_right_bars]
    div_last_macd_low := macd[div_right_bars]
    div_last_low_bar := bar_index - div_right_bars
if not na(div_ph)
    div_prev_price_high := div_last_price_high
    div_prev_rsi_high := div_last_rsi_high
    div_prev_macd_high := div_last_macd_high
    div_prev_high_bar := div_last_high_bar
    div_last_price_high := div_ph
    div_last_rsi_high := rsi[div_right_bars]
    div_last_macd_high := macd[div_right_bars]
    div_last_high_bar := bar_index - div_right_bars
bool div_bars_ok_low = not na(div_prev_low_bar) and not na(div_last_low_bar) and div_last_low_bar - div_prev_low_bar <= div_lookback_bars
bool div_bars_ok_high = not na(div_prev_high_bar) and not na(div_last_high_bar) and div_last_high_bar - div_prev_high_bar <= div_lookback_bars
bool bull_div_rsi = div_bars_ok_low and div_last_price_low < div_prev_price_low and div_last_rsi_low > div_prev_rsi_low
bool bull_div_macd = div_bars_ok_low and div_last_price_low < div_prev_price_low and div_last_macd_low > div_prev_macd_low
bool bear_div_rsi = div_bars_ok_high and div_last_price_high > div_prev_price_high and div_last_rsi_high < div_prev_rsi_high
bool bear_div_macd = div_bars_ok_high and div_last_price_high > div_prev_price_high and div_last_macd_high < div_prev_macd_high
bool div_ok_buy = bull_div_rsi or bull_div_macd
bool div_ok_sell = bear_div_rsi or bear_div_macd
bool osc_ok_buy = osc_mode == "OFF" ? true : osc_mode == "SIMPLE" ? (macd > signal and rsi > 50) : div_ok_buy
bool osc_ok_sell = osc_mode == "OFF" ? true : osc_mode == "SIMPLE" ? (macd < signal and rsi < 50) : div_ok_sell

bool pp_true_buy_ok = pp_true_buy_state > 0
bool pp_true_sell_ok = pp_true_sell_state > 0
bool pp_early_buy_ok = pp_early_buy_okf > 0
bool pp_early_sell_ok = pp_early_sell_okf > 0
bool pp_ok_buy = not pp_enabled or (pp_type == "TRUE" ? pp_true_buy_ok : pp_type == "EARLY" ? pp_early_buy_ok : (pp_true_buy_ok or pp_early_buy_ok))
bool pp_ok_sell = not pp_enabled or (pp_type == "TRUE" ? pp_true_sell_ok : pp_type == "EARLY" ? pp_early_sell_ok : (pp_true_sell_ok or pp_early_sell_ok))
string pp_state_buy = pp_ok_buy ? "OK" : (pp_true_buy_state == 0 ? "WAI" : "BAD")
string pp_state_sell = pp_ok_sell ? "OK" : (pp_true_sell_state == 0 ? "WAI" : "BAD")

bool trap_buy_event = has_buy and low < buy_bot and close >= buy_bot
bool trap_sell_event = has_sell and high > sell_top and close <= sell_top
string buy_tf = has_buy ? array.get(zones, buy_idx).tf : ""
string sell_tf = has_sell ? array.get(zones, sell_idx).tf : ""
float buy_tf_atr = buy_tf == htf1 ? htf1_atr : buy_tf == htf2 ? htf2_atr : buy_tf == htf3 ? htf3_atr : na
float sell_tf_atr = sell_tf == htf1 ? htf1_atr : sell_tf == htf2 ? htf2_atr : sell_tf == htf3 ? htf3_atr : na
float buy_tf_trap_range = buy_tf == htf1 ? htf1_trap_range : buy_tf == htf2 ? htf2_trap_range : buy_tf == htf3 ? htf3_trap_range : na
float sell_tf_trap_range = sell_tf == htf1 ? htf1_trap_range : sell_tf == htf2 ? htf2_trap_range : sell_tf == htf3 ? htf3_trap_range : na
bool trap_type2_buy = has_buy and close > buy_top and not na(buy_tf_trap_range) and not na(buy_tf_atr) and buy_tf_trap_range <= buy_tf_atr
bool trap_type2_sell = has_sell and close < sell_bot and not na(sell_tf_trap_range) and not na(sell_tf_atr) and sell_tf_trap_range <= sell_tf_atr
float buy_tf_vol = buy_tf == htf1 ? htf1_vol : buy_tf == htf2 ? htf2_vol : buy_tf == htf3 ? htf3_vol : na
float buy_tf_vol_ma = buy_tf == htf1 ? htf1_vol_ma : buy_tf == htf2 ? htf2_vol_ma : buy_tf == htf3 ? htf3_vol_ma : na
float sell_tf_vol = sell_tf == htf1 ? htf1_vol : sell_tf == htf2 ? htf2_vol : sell_tf == htf3 ? htf3_vol : na
float sell_tf_vol_ma = sell_tf == htf1 ? htf1_vol_ma : sell_tf == htf2 ? htf2_vol_ma : sell_tf == htf3 ? htf3_vol_ma : na
bool trap_vol_ok_buy = not trap_use_volume_gate or (has_buy and not na(buy_tf_vol) and not na(buy_tf_vol_ma) and buy_tf_vol <= buy_tf_vol_ma * trap_return_volume_mult)
bool trap_vol_ok_sell = not trap_use_volume_gate or (has_sell and not na(sell_tf_vol) and not na(sell_tf_vol_ma) and sell_tf_vol <= sell_tf_vol_ma * trap_return_volume_mult)
bool trap_ok_buy = not use_trap_confirm or ((trap_buy_event or trap_type2_buy) and trap_vol_ok_buy)
bool trap_ok_sell = not use_trap_confirm or ((trap_sell_event or trap_type2_sell) and trap_vol_ok_sell)

float buy_entry_plan = has_buy ? (entry_plan_mode == "POC" ? buy_poc : buy_top) : na
string poc_mode_note = poc_proxy_mode == "EXACT" ? "EXACT=VWAP proxy (true tape POC unavailable in Pine)" : "FAST=volume bins on HLC3"
string trend_note = "Trend dir: EMA21>EMA55 bullish, EMA21<EMA55 bearish"
string tf_guard_note = ltf_below_chart ? "LTF guard: requested " + ltf_raw + " < chart, forced to " + ltf : ""
string htf_guard_note = htf_order_ok ? "" : "HTF order warning: expected HTF1>HTF2>HTF3"
float sell_entry_plan = has_sell ? (entry_plan_mode == "POC" ? sell_poc : sell_bot) : na
float buy_base_lo = has_buy ? array.get(zones, buy_idx).base_lo : na
float sell_base_hi = has_sell ? array.get(zones, sell_idx).base_hi : na
// Два режима стоп-лосса по методологии
float buy_stop_safe = has_buy ? buy_base_lo - buy_atr * stop_pad_atr_mult : na  // Безопасный: за границей структуры + ATR
float sell_stop_safe = has_sell ? sell_base_hi + sell_atr * stop_pad_atr_mult : na

float buy_stop_risky = has_buy ? ta.lowest(low, 20) - syminfo.mintick : na  // Рисковый: за локальным экстремумом
float sell_stop_risky = has_sell ? ta.highest(high, 20) + syminfo.mintick : na

// Выбор режима
float buy_stop_anchor = stop_mode == "BASE" ? buy_base_lo : ta.lowest(low, 20)
float sell_stop_anchor = stop_mode == "BASE" ? sell_base_hi : ta.highest(high, 20)
float buy_pad = has_buy ? math.max(buy_base_lo * stop_pad_pct * 0.01, buy_atr * stop_pad_atr_mult) : na
float sell_pad = has_sell ? math.max(sell_base_hi * stop_pad_pct * 0.01, sell_atr * stop_pad_atr_mult) : na
float buy_stop = has_buy and not na(buy_stop_anchor) and not na(buy_pad) ? (stop_mode == "BASE" ? buy_stop_safe : buy_stop_risky) : na
float sell_stop = has_sell and not na(sell_stop_anchor) and not na(sell_pad) ? (stop_mode == "BASE" ? sell_stop_safe : sell_stop_risky) : na
float buy_stopvol_dist = na
float sell_stopvol_dist = na
float buy_near_abs = has_buy ? math.abs(buy_base_lo) * stopvol_near_pct * 0.01 : na
float sell_near_abs = has_sell ? math.abs(sell_base_hi) * stopvol_near_pct * 0.01 : na
if stop_mode == "STOPVOL_NEAR"
    for i = 0 to array.size(zones) - 1
        bool same_tf_buy = has_buy and array.get(zones, i).tf == array.get(zones, buy_idx).tf
        bool same_tf_sell = has_sell and array.get(zones, i).tf == array.get(zones, sell_idx).tf
        bool active_stopvol = array.get(zones, i).status <= Z_TOUCHED and array.get(zones, i).origin == "STOPVOL"
        if same_tf_buy and active_stopvol and not na(buy_near_abs)
            float cand_buy_anchor = array.get(zones, i).base_lo
            float cand_buy_dist = math.abs(cand_buy_anchor - buy_base_lo)
            if cand_buy_dist <= buy_near_abs and (na(buy_stopvol_dist) or cand_buy_dist < buy_stopvol_dist)
                buy_stopvol_dist := cand_buy_dist
                buy_stop_anchor := math.min(buy_base_lo, cand_buy_anchor)
        if same_tf_sell and active_stopvol and not na(sell_near_abs)
            float cand_sell_anchor = array.get(zones, i).base_hi
            float cand_sell_dist = math.abs(cand_sell_anchor - sell_base_hi)
            if cand_sell_dist <= sell_near_abs and (na(sell_stopvol_dist) or cand_sell_dist < sell_stopvol_dist)
                sell_stopvol_dist := cand_sell_dist
                sell_stop_anchor := math.max(sell_base_hi, cand_sell_anchor)
float buy_tp = has_buy ? buy_entry_plan + rr_fallback_atr * buy_atr : na
float sell_tp = has_sell ? sell_entry_plan - rr_fallback_atr * sell_atr : na
float best_buy_tp_dist = na
float best_sell_tp_dist = na
string buy_tp_source = has_buy ? "Fallback: ATR*" + str.tostring(rr_fallback_atr, format.mintick) + " (no opposite zones, " + poc_mode_note + ")" : ""
string sell_tp_source = has_sell ? "Fallback: ATR*" + str.tostring(rr_fallback_atr, format.mintick) + " (no opposite zones, " + poc_mode_note + ")" : ""
for i = 0 to array.size(zones) - 1
    if has_buy and array.get(zones, i).typ == -1 and array.get(zones, i).status <= Z_TOUCHED and array.get(zones, i).tf == array.get(zones, buy_idx).tf
        float cand_buy_tp = array.get(zones, i).poc
        float cand_buy_dist = cand_buy_tp - buy_entry_plan
        if cand_buy_dist > EPS and (na(best_buy_tp_dist) or cand_buy_dist < best_buy_tp_dist)
            best_buy_tp_dist := cand_buy_dist
            buy_tp := cand_buy_tp
            buy_tp_source := "TP: nearest SUPPLY(" + array.get(zones, i).tf + ") dist=" + str.tostring(cand_buy_dist, format.mintick)
    if has_sell and array.get(zones, i).typ == 1 and array.get(zones, i).status <= Z_TOUCHED and array.get(zones, i).tf == array.get(zones, sell_idx).tf
        float cand_sell_tp = array.get(zones, i).poc
        float cand_sell_dist = sell_entry_plan - cand_sell_tp
        if cand_sell_dist > EPS and (na(best_sell_tp_dist) or cand_sell_dist < best_sell_tp_dist)
            best_sell_tp_dist := cand_sell_dist
            sell_tp := cand_sell_tp
            sell_tp_source := "TP: nearest DEMAND(" + array.get(zones, i).tf + ") dist=" + str.tostring(cand_sell_dist, format.mintick)

bool buy_tp_updated = has_buy and not na(buy_tp) and not na(buy_tp[1]) and math.abs(buy_tp - buy_tp[1]) > EPS
bool sell_tp_updated = has_sell and not na(sell_tp) and not na(sell_tp[1]) and math.abs(sell_tp - sell_tp[1]) > EPS
bool tp_updated = buy_tp_updated or sell_tp_updated

float buy_risk = has_buy and not na(buy_entry_plan) and not na(buy_stop) ? buy_entry_plan - buy_stop : na
float buy_reward = has_buy and not na(buy_tp) and not na(buy_entry_plan) ? buy_tp - buy_entry_plan : na
float sell_risk = has_sell and not na(sell_stop) and not na(sell_entry_plan) ? sell_stop - sell_entry_plan : na
float sell_reward = has_sell and not na(sell_entry_plan) and not na(sell_tp) ? sell_entry_plan - sell_tp : na
float rr_buy = has_buy and buy_risk > EPS and buy_reward > EPS ? buy_reward / buy_risk : na
float rr_sell = has_sell and sell_risk > EPS and sell_reward > EPS ? sell_reward / sell_risk : na
bool rr_ok_buy = not use_rr_gate or (has_buy and not na(rr_buy) and rr_buy >= rr_min)
bool rr_ok_sell = not use_rr_gate or (has_sell and not na(rr_sell) and rr_sell >= rr_min)

float buy_trig_level_legacy = entry_plan_mode == "ZONE_EDGE" ? buy_top : math.max(ltf_trig_up, buy_entry_plan)
float sell_trig_level_legacy = entry_plan_mode == "ZONE_EDGE" ? sell_bot : math.min(ltf_trig_dn, sell_entry_plan)
float buy_trig_level_strict = ltf_trig_up
float sell_trig_level_strict = ltf_trig_dn
bool trig_valid_buy = f_detect_trigger(has_buy, trigger_mode == "LEGACY_MAX" ? buy_trig_level_legacy : buy_trig_level_strict, buy_entry_plan, 1)
bool trig_valid_sell = f_detect_trigger(has_sell, trigger_mode == "LEGACY_MAX" ? sell_trig_level_legacy : sell_trig_level_strict, sell_entry_plan, -1)
float buy_trig_level = trigger_mode == "LEGACY_MAX" ? buy_trig_level_legacy : (trig_valid_buy ? buy_trig_level_strict : na)
float sell_trig_level = trigger_mode == "LEGACY_MAX" ? sell_trig_level_legacy : (trig_valid_sell ? sell_trig_level_strict : na)
bool buy_trig_level_changed = trigger_mode == "STRICT_SWING" and has_buy and not na(ltf_trig_up) and not na(ltf_trig_up[1]) and math.abs(ltf_trig_up - ltf_trig_up[1]) > EPS
bool sell_trig_level_changed = trigger_mode == "STRICT_SWING" and has_sell and not na(ltf_trig_dn) and not na(ltf_trig_dn[1]) and math.abs(ltf_trig_dn - ltf_trig_dn[1]) > EPS
bool buy_trig_cross_old = has_buy and not na(ltf_close) and not na(ltf_close[1]) and not na(ltf_trig_up[1]) and ltf_close > ltf_trig_up[1] + EPS and ltf_close[1] <= ltf_trig_up[1] + EPS
bool buy_trig_cross_new = has_buy and not na(ltf_close) and not na(ltf_close[1]) and not na(ltf_trig_up) and ltf_close > ltf_trig_up + EPS and ltf_close[1] <= ltf_trig_up + EPS
bool sell_trig_cross_old = has_sell and not na(ltf_close) and not na(ltf_close[1]) and not na(ltf_trig_dn[1]) and ltf_close < ltf_trig_dn[1] - EPS and ltf_close[1] >= ltf_trig_dn[1] - EPS
bool sell_trig_cross_new = has_sell and not na(ltf_close) and not na(ltf_close[1]) and not na(ltf_trig_dn) and ltf_close < ltf_trig_dn - EPS and ltf_close[1] >= ltf_trig_dn - EPS
bool trig_level_stable_buy = trigger_mode != "STRICT_SWING" or not buy_trig_level_changed or buy_trig_cross_old or buy_trig_cross_new
bool trig_level_stable_sell = trigger_mode != "STRICT_SWING" or not sell_trig_level_changed or sell_trig_cross_old or sell_trig_cross_new
bool buy_level_changed = trigger_mode == "LEGACY_MAX" and has_buy and not na(buy_trig_level) and not na(buy_trig_level[1]) and math.abs(buy_trig_level - buy_trig_level[1]) > EPS
bool sell_level_changed = trigger_mode == "LEGACY_MAX" and has_sell and not na(sell_trig_level) and not na(sell_trig_level[1]) and math.abs(sell_trig_level - sell_trig_level[1]) > EPS
bool entry_trigger_ok_buy = trig_valid_buy and trig_level_stable_buy and not buy_level_changed and not na(ltf_close) and not na(ltf_close[1]) and not na(buy_trig_level) and not na(buy_trig_level[1]) and ltf_close > buy_trig_level + EPS and ltf_close[1] <= buy_trig_level[1] + EPS
bool entry_trigger_ok_sell = trig_valid_sell and trig_level_stable_sell and not sell_level_changed and not na(ltf_close) and not na(ltf_close[1]) and not na(sell_trig_level) and not na(sell_trig_level[1]) and ltf_close < sell_trig_level - EPS and ltf_close[1] >= sell_trig_level[1] - EPS
bool trig_shift_buy = trigger_mode == "STRICT_SWING" and trig_valid_buy and buy_trig_level_changed and not buy_trig_cross_old and not buy_trig_cross_new
bool trig_shift_sell = trigger_mode == "STRICT_SWING" and trig_valid_sell and sell_trig_level_changed and not sell_trig_cross_old and not sell_trig_cross_new

bool all_filters_ok_buy = rr_ok_buy and pp_ok_buy and trap_ok_buy and osc_ok_buy and ema_bias_ok_buy
bool all_filters_ok_sell = rr_ok_sell and pp_ok_sell and trap_ok_sell and osc_ok_sell and ema_bias_ok_sell
bool blocked_filters_buy = has_buy and buy_in_zone and ltf_gate_ok_buy and not all_filters_ok_buy
bool blocked_filters_sell = has_sell and sell_in_zone and ltf_gate_ok_sell and not all_filters_ok_sell
bool wait_trig_buy = has_buy and buy_in_zone and ltf_gate_ok_buy and all_filters_ok_buy and (not trig_valid_buy or not entry_trigger_ok_buy)
bool wait_trig_sell = has_sell and sell_in_zone and ltf_gate_ok_sell and all_filters_ok_sell and (not trig_valid_sell or not entry_trigger_ok_sell)
string rr_reason_buy = not rr_ok_buy ? "RR<MIN" : ""
string pp_reason_buy = not pp_ok_buy ? "NO_PP" : ""
string trap_reason_buy = not trap_ok_buy ? "NO_TRAP" : ""
string osc_reason_buy = not osc_ok_buy ? "OSC_FAIL" : ""
string ema_reason_buy = not ema_bias_ok_buy ? "EMA_BIAS" : ""
string trig_reason_buy = not trig_valid_buy ? "TRIG_BAD" : trig_shift_buy or buy_level_changed ? "TRIG_JUMP" : ""
string rr_reason_sell = not rr_ok_sell ? "RR<MIN" : ""
string pp_reason_sell = not pp_ok_sell ? "NO_PP" : ""
string trap_reason_sell = not trap_ok_sell ? "NO_TRAP" : ""
string osc_reason_sell = not osc_ok_sell ? "OSC_FAIL" : ""
string ema_reason_sell = not ema_bias_ok_sell ? "EMA_BIAS" : ""
string trig_reason_sell = not trig_valid_sell ? "TRIG_BAD" : trig_shift_sell or sell_level_changed ? "TRIG_JUMP" : ""
int block_buy_flags = 0
block_buy_flags := block_buy_flags | (not rr_ok_buy ? BLOCK_RR : 0)
block_buy_flags := block_buy_flags | (not pp_ok_buy ? BLOCK_PP : 0)
block_buy_flags := block_buy_flags | (not trap_ok_buy ? BLOCK_TRAP : 0)
block_buy_flags := block_buy_flags | (not osc_ok_buy ? BLOCK_OSC : 0)
block_buy_flags := block_buy_flags | (not ema_bias_ok_buy ? BLOCK_EMA : 0)
block_buy_flags := block_buy_flags | (trig_shift_buy or buy_level_changed ? BLOCK_TRIG_JUMP : 0)
int block_sell_flags = 0
block_sell_flags := block_sell_flags | (not rr_ok_sell ? BLOCK_RR : 0)
block_sell_flags := block_sell_flags | (not pp_ok_sell ? BLOCK_PP : 0)
block_sell_flags := block_sell_flags | (not trap_ok_sell ? BLOCK_TRAP : 0)
block_sell_flags := block_sell_flags | (not osc_ok_sell ? BLOCK_OSC : 0)
block_sell_flags := block_sell_flags | (not ema_bias_ok_sell ? BLOCK_EMA : 0)
block_sell_flags := block_sell_flags | (trig_shift_sell or sell_level_changed ? BLOCK_TRIG_JUMP : 0)
string block_reason_buy = blocked_filters_buy ? str.trim((rr_reason_buy + " " + pp_reason_buy + " " + trap_reason_buy + " " + osc_reason_buy + " " + ema_reason_buy + " " + trig_reason_buy)) : ""
string block_reason_sell = blocked_filters_sell ? str.trim((rr_reason_sell + " " + pp_reason_sell + " " + trap_reason_sell + " " + osc_reason_sell + " " + ema_reason_sell + " " + trig_reason_sell)) : ""
string block_hint_buy = f_block_hint(blocked_filters_buy, trig_valid_buy)
string block_hint_sell = f_block_hint(blocked_filters_sell, trig_valid_sell)
bool blocked_buy = blocked_filters_buy
bool blocked_sell = blocked_filters_sell

string stage_buy = STAGE_FAR
string stage_sell = STAGE_FAR
if has_buy
    if not buy_near
        stage_buy := STAGE_FAR
    else if not buy_in_zone
        stage_buy := STAGE_NEAR
    else if not ltf_gate_ok_buy
        stage_buy := STAGE_IN_ZONE
    else if not all_filters_ok_buy
        stage_buy := STAGE_LTF_READY
    else if wait_trig_buy
        stage_buy := STAGE_CONFIRM_READY
    else
        stage_buy := STAGE_ENTRY
if has_sell
    if not sell_near
        stage_sell := STAGE_FAR
    else if not sell_in_zone
        stage_sell := STAGE_NEAR
    else if not ltf_gate_ok_sell
        stage_sell := STAGE_IN_ZONE
    else if not all_filters_ok_sell
        stage_sell := STAGE_LTF_READY
    else if wait_trig_sell
        stage_sell := STAGE_CONFIRM_READY
    else
        stage_sell := STAGE_ENTRY

var string prev_stage_buy = STAGE_FAR
var string prev_stage_sell = STAGE_FAR
var bool prev_blocked_buy = false
var bool prev_blocked_sell = false
var bool prev_div_ok_buy = false
var bool prev_div_ok_sell = false

bool buy_stage_transition = stage_buy != prev_stage_buy
bool sell_stage_transition = stage_sell != prev_stage_sell
bool blocked_buy_edge = blocked_filters_buy and not prev_blocked_buy
bool blocked_sell_edge = blocked_filters_sell and not prev_blocked_sell
bool near_buy_edge = buy_stage_transition and stage_buy == STAGE_NEAR
bool near_sell_edge = sell_stage_transition and stage_sell == STAGE_NEAR
bool in_zone_buy_edge = buy_stage_transition and stage_buy == STAGE_IN_ZONE
bool in_zone_sell_edge = sell_stage_transition and stage_sell == STAGE_IN_ZONE
bool ltf_ready_buy_edge = buy_stage_transition and stage_buy == STAGE_LTF_READY
bool ltf_ready_sell_edge = sell_stage_transition and stage_sell == STAGE_LTF_READY
bool confirm_ready_buy_edge = buy_stage_transition and stage_buy == STAGE_CONFIRM_READY
bool confirm_ready_sell_edge = sell_stage_transition and stage_sell == STAGE_CONFIRM_READY
bool entry_buy_sig = buy_stage_transition and stage_buy == STAGE_ENTRY
bool entry_sell_sig = sell_stage_transition and stage_sell == STAGE_ENTRY
bool div_enabled = osc_mode == "DIVERGENCE"
bool div_ok_buy_edge = div_enabled and has_buy and osc_ok_buy and not prev_div_ok_buy
bool div_fail_buy_edge = div_enabled and has_buy and not osc_ok_buy and prev_div_ok_buy
bool div_ok_sell_edge = div_enabled and has_sell and osc_ok_sell and not prev_div_ok_sell
bool div_fail_sell_edge = div_enabled and has_sell and not osc_ok_sell and prev_div_ok_sell

if show_labels_eff and near_buy_edge
    f_push_icon("⏳ BUY", color.new(color.green, 30), false)
if show_labels_eff and near_sell_edge
    f_push_icon("⏳ SELL", color.new(color.red, 30), false)
if show_labels_eff and in_zone_buy_edge
    f_push_icon("⚡ BUY", color.new(color.green, 0), false)
if show_labels_eff and in_zone_sell_edge
    f_push_icon("⚡ SELL", color.new(color.red, 0), false)
if show_labels_eff and confirm_ready_buy_edge
    f_push_icon("✅ BUY", color.new(color.blue, 0), false)
if show_labels_eff and confirm_ready_sell_edge
    f_push_icon("✅ SELL", color.new(color.blue, 0), false)
if show_labels_eff and entry_buy_sig
    f_push_icon("▲ ENTRY BUY", color.new(color.lime, 0), true)
if show_labels_eff and entry_sell_sig
    f_push_icon("▼ ENTRY SELL", color.new(color.red, 0), false)
if show_labels_eff and blocked_buy_edge
    f_push_icon("⛔ BUY " + block_reason_buy, color.new(color.maroon, 0), false)
if show_labels_eff and blocked_sell_edge
    f_push_icon("⛔ SELL " + block_reason_sell, color.new(color.maroon, 0), false)

if ui_clean or not show_labels_eff
    f_clear_icons()
else
    while array.size(event_icons) > icon_keep_eff
        label old = array.shift(event_icons)
        if not na(old)
            label.delete(old)

if draw_now
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)  // ✅ ОБЪЯВЛЯЕМ z ЗДЕСЬ
        box bx = z.box_id
        label lb = z.label_id
        int typ = z.typ
        string tfz = z.tf
        bool is_active = z.id == active_buy_zone_id or z.id == active_sell_zone_id
        color side_col = typ == 1 ? color.lime : color.red
        int fill_opa = tfz == htf1 ? 80 : 90
        if not na(bx)
            // Цвет по статусу зоны (исправлено: if-else вместо многострочного тернара)
            color zone_status_color = color.blue
            if z.status == Z_ACTIVE
                zone_status_color := side_col
            else if z.status == Z_TOUCHED
                zone_status_color := color.yellow
            else if z.status == Z_CONSUMED
                zone_status_color := color.gray
            else if z.status == Z_INVALID
                zone_status_color := color.red
            
            // Стиль линии для слабых уровней
            int border_width = z.isWeak ? 1 : (is_active ? 2 : 1)
            line_style border_style = z.isWeak ? line.style_dashed : line.style_solid
            
            box.set_bgcolor(bx, color.new(zone_status_color, is_active ? fill_opa - 8 : fill_opa))
            box.set_border_color(bx, color.new(zone_status_color, is_active ? 0 : 25))
            box.set_border_width(bx, border_width)
        if not na(lb)
            label.set_text(lb, (typ == 1 ? "BUY " : "SELL ") + tfz + " T:" + str.tostring(z.touch) + (is_active ? " ACTIVE" : ""))
            label.set_color(lb, color.new(side_col, is_active ? 5 : 20))

plot(show_rr_lines_eff and has_buy ? buy_entry_plan : na, "BUY entry", color=color.new(color.lime, 0), linewidth=1, style=plot.style_linebr)
plot(show_rr_lines_eff and has_buy ? buy_stop : na, "BUY stop", color=color.new(color.red, 0), linewidth=1, style=plot.style_linebr)
plot(show_rr_lines_eff and has_buy ? buy_tp : na, "BUY tp", color=color.new(color.blue, 0), linewidth=1, style=plot.style_linebr)
plot(show_rr_lines_eff and has_sell ? sell_entry_plan : na, "SELL entry", color=color.new(color.orange, 0), linewidth=1, style=plot.style_linebr)
plot(show_rr_lines_eff and has_sell ? sell_stop : na, "SELL stop", color=color.new(color.maroon, 0), linewidth=1, style=plot.style_linebr)
plot(show_rr_lines_eff and has_sell ? sell_tp : na, "SELL tp", color=color.new(color.aqua, 0), linewidth=1, style=plot.style_linebr)

var label active_buy_label = na
var label active_sell_label = na
if draw_now and barstate.islast
    if na(active_buy_label)
        active_buy_label := label.new(time, high, "", xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.new(color.lime, 0), color=color.new(color.black, 80), size=size.tiny)
    if na(active_sell_label)
        active_sell_label := label.new(time, low, "", xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.new(color.red, 0), color=color.new(color.black, 80), size=size.tiny)
    label.set_x(active_buy_label, time)
    label.set_y(active_buy_label, high)
    string buy_flip_scn = has_buy and flip_on_break and buy_idx >= 0 and array.get(zones, buy_idx).status == Z_INVALID and not na(array.get(zones, buy_idx).break_seq) ? "\nScenario: flip retest window " + str.tostring(flip_retest_bars) + " bars" : ""
    label.set_text(active_buy_label, has_buy ? "BUY: " + buy_origin + " " + (stage_buy == STAGE_LTF_READY ? "READY" : stage_buy) + "\n" + buy_tp_source + buy_flip_scn : "BUY: n/a")
    label.set_x(active_sell_label, time)
    label.set_y(active_sell_label, low)
    string sell_flip_scn = has_sell and flip_on_break and sell_idx >= 0 and array.get(zones, sell_idx).status == Z_INVALID and not na(array.get(zones, sell_idx).break_seq) ? "\nScenario: flip retest window " + str.tostring(flip_retest_bars) + " bars" : ""
    label.set_text(active_sell_label, has_sell ? "SELL: " + sell_origin + " " + (stage_sell == STAGE_LTF_READY ? "READY" : stage_sell) + "\n" + sell_tp_source + sell_flip_scn : "SELL: n/a")

alertcondition(near_buy_edge, "near_buy", "Price NEAR BUY zone")
alertcondition(near_sell_edge, "near_sell", "Price NEAR SELL zone")
alertcondition(in_zone_buy_edge, "in_zone_buy", "Price entered BUY zone")
alertcondition(in_zone_sell_edge, "in_zone_sell", "Price entered SELL zone")
alertcondition(ltf_ready_buy_edge, "ltf_ready_buy", "LTF gate ready for BUY")
alertcondition(ltf_ready_sell_edge, "ltf_ready_sell", "LTF gate ready for SELL")
alertcondition(confirm_ready_buy_edge, "confirm_ready_buy", "Confirm ready BUY")
alertcondition(confirm_ready_sell_edge, "confirm_ready_sell", "Confirm ready SELL")
alertcondition(entry_buy_sig, "entry_buy", "ENTRY BUY")
alertcondition(entry_sell_sig, "entry_sell", "ENTRY SELL")
alertcondition(blocked_buy_edge, "blocked_buy", "BUY blocked")
alertcondition(blocked_sell_edge, "blocked_sell", "SELL blocked")
alertcondition(zone_created, "zone_created", "HTF zone created")
alertcondition(zone_invalidated, "zone_invalidated", "HTF zone invalidated")
alertcondition(zone_consumed, "zone_consumed", "HTF zone consumed")
alertcondition(zone_flipped, "zone_flipped", "HTF zone flipped")
alertcondition(tp_updated, "tp_updated", "TP target source updated")
alertcondition(flip_armed, "flip_armed", "Flip scenario armed")
alertcondition(zone_flipped, "flip_done", "Flip scenario completed")
alertcondition(trap_buy_event, "trap_event_buy", "Trap event BUY")
alertcondition(trap_sell_event, "trap_event_sell", "Trap event SELL")

var table hud = table.new(position.top_right, 7, 5, bgcolor=color.new(color.black, 80))
if draw_now and barstate.islast and show_hud
    table.cell(hud, 0, 0, "SIDE", text_color=color.white)
    table.cell(hud, 1, 0, "ZONE", text_color=color.white)
    table.cell(hud, 2, 0, "STAGE", text_color=color.white)
    table.cell(hud, 3, 0, "BLOCK", text_color=color.white)
    table.cell(hud, 4, 0, "MODS", text_color=color.white)
    table.cell(hud, 5, 0, "TF/ORG", text_color=color.white)
    table.cell(hud, 6, 0, "LEGEND", text_color=color.white)
    table.cell(hud, 0, 1, "BUY", text_color=color.lime)
    table.cell(hud, 1, 1, has_buy ? str.tostring(buy_poc, format.mintick) : "n/a", text_color=color.white)
    table.cell(hud, 2, 1, stage_buy == STAGE_NEAR ? "⏳ NEAR" : stage_buy == STAGE_IN_ZONE ? "⚡ IN_ZONE" : stage_buy == STAGE_CONFIRM_READY ? "✅ CONFIRM_READY" : stage_buy == STAGE_ENTRY ? "▲ ENTRY" : stage_buy, text_color=color.white)
    table.cell(hud, 3, 1, blocked_filters_buy ? "⛔ " + block_reason_buy + "\n" + block_hint_buy : (wait_trig_buy ? (trig_shift_buy ? "TRIG SHIFT" : trig_valid_buy ? "WAIT TRIG" : "TRIG BAD") : (has_buy and not buy_near ? "FAR" : has_buy and not buy_in_zone ? "NEAR" : "WAIT FILTERS")), text_color=blocked_filters_buy ? color.orange : color.silver)
    table.cell(hud, 4, 1, "TRIG:" + (trig_valid_buy ? "OK" : "BAD") + " RR:" + (has_buy and not na(rr_buy) ? str.tostring(rr_buy, format.mintick) : "n/a") + " PP:" + pp_state_buy + " T/O/L:" + (trap_ok_buy ? "OK" : "BAD") + "/" + (osc_ok_buy ? "OK" : "BAD") + "/" + (ltf_gate_ok_buy ? "OK" : "BAD") + (has_buy ? "\n" + buy_tp_source : "") + (has_buy and flip_on_break and buy_idx >= 0 and array.get(zones, buy_idx).status == Z_INVALID and not na(array.get(zones, buy_idx).break_seq) ? "\nScenario: flip retest window " + str.tostring(flip_retest_bars) + " bars" : ""), text_color=color.silver)
    table.cell(hud, 5, 1, has_buy ? array.get(zones, buy_idx).tf + "/" + buy_origin : "-", text_color=color.white)
    table.cell(hud, 0, 2, "SELL", text_color=color.red)
    table.cell(hud, 1, 2, has_sell ? str.tostring(sell_poc, format.mintick) : "n/a", text_color=color.white)
    table.cell(hud, 2, 2, stage_sell == STAGE_NEAR ? "⏳ NEAR" : stage_sell == STAGE_IN_ZONE ? "⚡ IN_ZONE" : stage_sell == STAGE_CONFIRM_READY ? "✅ CONFIRM_READY" : stage_sell == STAGE_ENTRY ? "▼ ENTRY" : stage_sell, text_color=color.white)
    table.cell(hud, 3, 2, blocked_filters_sell ? "⛔ " + block_reason_sell + "\n" + block_hint_sell : (wait_trig_sell ? (trig_shift_sell ? "TRIG SHIFT" : trig_valid_sell ? "WAIT TRIG" : "TRIG BAD") : (has_sell and not sell_near ? "FAR" : has_sell and not sell_in_zone ? "NEAR" : "WAIT FILTERS")), text_color=blocked_filters_sell ? color.orange : color.silver)
    table.cell(hud, 4, 2, "TRIG:" + (trig_valid_sell ? "OK" : "BAD") + " RR:" + (has_sell and not na(rr_sell) ? str.tostring(rr_sell, format.mintick) : "n/a") + " PP:" + pp_state_sell + " T/O/L:" + (trap_ok_sell ? "OK" : "BAD") + "/" + (osc_ok_sell ? "OK" : "BAD") + "/" + (ltf_gate_ok_sell ? "OK" : "BAD") + (has_sell ? "\n" + sell_tp_source : "") + (has_sell and flip_on_break and sell_idx >= 0 and array.get(zones, sell_idx).status == Z_INVALID and not na(array.get(zones, sell_idx).break_seq) ? "\nScenario: flip retest window " + str.tostring(flip_retest_bars) + " bars" : ""), text_color=color.silver)
    table.cell(hud, 5, 2, has_sell ? array.get(zones, sell_idx).tf + "/" + sell_origin : "-", text_color=color.white)
    table.cell(hud, 0, 3, "TF", text_color=color.white)
    table.cell(hud, 1, 3, htf1 + "/" + htf2 + (use_htf3 ? "/" + htf3 : "") + "/" + ltf + " ui:" + ui_mode + " touch:" + touch_mode + " poc:" + poc_proxy_mode + (ltf_below_chart ? " [LTF CLAMP]" : "") + (htf_order_ok ? "" : " [HTF ORDER?]"), text_color=color.silver)
    table.cell(hud, 0, 4, ui_clean ? "Mode" : "Legend", text_color=color.white)
    table.cell(hud, 1, 4, ui_clean ? "CLEAN" : "⏳ near ⚡ zone ✅ confirm ▲▼ entry ⛔ blocked", text_color=color.silver)
    table.cell(hud, 2, 4, (ui_full or ui_debug) ? (icons_budget_disabled ? "icons disabled (budget)" : "icons: " + str.tostring(icon_keep_eff) + "/" + str.tostring(icon_keep)) : "", text_color=color.silver)
    table.cell(hud, 6, 4, (ui_full or ui_debug) ? "PP/DIV use confirmed pivots (delayed)" : "", text_color=color.silver)
    if ui_debug
        table.cell(hud, 2, 3, poc_mode_note, text_color=color.orange)
        table.cell(hud, 3, 3, trend_note, text_color=color.silver)
        table.cell(hud, 4, 3, tf_guard_note, text_color=color.orange)
        table.cell(hud, 5, 3, htf_guard_note, text_color=color.orange)


type Event
    string t
    string side
    string kind
    string text

var Event[] events = array.new<Event>()
int audit_keep = 10
f_event_push(string _side, string _kind, string _text) =>
    Event ev = Event.new(str.tostring(time), _side, _kind, _text)
    array.push(events, ev)

f_event_prune() =>
    while array.size(events) > audit_keep
        array.shift(events)

f_event_render_row(int _idx) =>
    Event ev = array.get(events, _idx)
    [ev.t, ev.side + "/" + ev.kind + ": " + ev.text]

if zone_created
    f_event_push("SYS", "zone", "zone_created")
if zone_invalidated
    f_event_push("SYS", "zone", "zone_invalidated")
if zone_consumed
    f_event_push("SYS", "zone", "zone_consumed")
if zone_flipped
    f_event_push("SYS", "zone", "zone_flipped")
if flip_armed
    f_event_push("SYS", "flip", "FLIP_ARMED")
if zone_flipped
    f_event_push("SYS", "flip", "FLIP_DONE")
if flip_expired
    f_event_push("SYS", "flip", "FLIP_EXPIRED")
if near_buy_edge
    f_event_push("BUY", "stage", "near_edge")
if near_sell_edge
    f_event_push("SELL", "stage", "near_edge")
if in_zone_buy_edge
    f_event_push("BUY", "stage", "in_zone_edge")
if in_zone_sell_edge
    f_event_push("SELL", "stage", "in_zone_edge")
if confirm_ready_buy_edge
    f_event_push("BUY", "stage", "confirm_ready")
if confirm_ready_sell_edge
    f_event_push("SELL", "stage", "confirm_ready")
if entry_buy_sig
    f_event_push("BUY", "entry", "entry")
if entry_sell_sig
    f_event_push("SELL", "entry", "entry")
if blocked_buy_edge
    f_event_push("BUY", "blocked", block_reason_buy)
if blocked_sell_edge
    f_event_push("SELL", "blocked", block_reason_sell)
if div_ok_buy_edge
    f_event_push("BUY", "DIV_OK", "bullish divergence confirmed")
if div_fail_buy_edge
    f_event_push("BUY", "DIV_FAIL", "bullish divergence missing")
if div_ok_sell_edge
    f_event_push("SELL", "DIV_OK", "bearish divergence confirmed")
if div_fail_sell_edge
    f_event_push("SELL", "DIV_FAIL", "bearish divergence missing")

f_event_prune()

var table audit_tbl = table.new(position.bottom_right, 2, 11, bgcolor=color.new(color.black, 85))
if draw_now and barstate.islast and show_hud and (ui_full or ui_debug)
    table.cell(audit_tbl, 0, 0, "TIME", text_color=color.white)
    table.cell(audit_tbl, 1, 0, "EVENT", text_color=color.white)
    for r = 1 to 10
        int idx = array.size(events) - r
        string t = ""
        string e = ""
        if idx >= 0
            [t, e] = f_event_render_row(idx)
        table.cell(audit_tbl, 0, r, t, text_color=color.silver)
        table.cell(audit_tbl, 1, r, e, text_color=color.silver)

prev_stage_buy := stage_buy
prev_stage_sell := stage_sell
prev_blocked_buy := blocked_buy
prev_blocked_sell := blocked_sell
prev_div_ok_buy := div_enabled and has_buy and osc_ok_buy
prev_div_ok_sell := div_enabled and has_sell and osc_ok_sell
