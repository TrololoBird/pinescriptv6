//@version=6
indicator("Prizrak Trade Setup Detector v12.1.0", overlay=true, max_boxes_count=300, max_labels_count=300)

mode_tf = input.string("AUTO", "TF mode", options=["AUTO", "MANUAL"], group="TF Hierarchy")
manual_htf1 = input.timeframe("240", "Manual HTF1", group="TF Hierarchy")
manual_htf2 = input.timeframe("60", "Manual HTF2", group="TF Hierarchy")
manual_ltf = input.timeframe("", "Manual LTF (blank = chart)", group="TF Hierarchy")
auto_ltf_mode = input.string("AUTO_BY_CHART", "AUTO LTF mode", options=["AUTO_BY_CHART", "AUTO_BY_HTF2", "CHART"], group="TF Hierarchy")

base_len = input.int(28, "HTF base length", minval=8, maxval=200, group="Zone Engine • HTF")
touch_tolerance = input.float(0.0025, "HTF base touch tolerance", minval=0.0005, step=0.0005, group="Zone Engine • HTF")
min_touches = input.int(4, "HTF base min touches", minval=2, maxval=20, group="Zone Engine • HTF")
max_range_atr = input.float(1.6, "HTF base max range ATR", minval=0.5, step=0.1, group="Zone Engine • HTF")
exit_confirm_bars = input.int(2, "HTF base exit confirm bars", minval=1, maxval=6, group="Zone Engine • HTF")
htf_poc_pad_mult = input.float(0.35, "HTF POC pad ATR mult", minval=0.05, step=0.05, group="Zone Engine • HTF")
max_zones_per_tf = input.int(8, "Max zones per TF per side", minval=1, maxval=20, group="Zone Engine • HTF")
max_age_bars = input.int(700, "Max age bars", minval=50, maxval=5000, group="Zone Engine • HTF")
consume_reaction_atr_mult = input.float(0.9, "Consume reaction ATR mult", minval=0.2, step=0.1, group="Zone Engine • HTF")
invalidate_confirm_bars = input.int(2, "Invalidate confirm bars", minval=1, maxval=5, group="Zone Engine • HTF")
body_confirm = input.bool(true, "Body confirm (close+body)", group="Zone Engine • HTF")
flip_on_break = input.bool(true, "Flip zone on invalidation", group="Zone Engine • HTF")
show_consumed_history = input.bool(false, "Show consumed history", group="Zone Engine • HTF")

ltf_zone_mode = input.string("POC", "LTF entry zone mode", options=["POC", "ACCUM", "FLAT"], group="Zone Engine • LTF")
use_ltf_entry_gate = input.bool(true, "Use LTF entry gate", group="Zone Engine • LTF")
ltf_gate_mode = input.string("NEAR", "LTF gate mode", options=["NEAR", "IN_ZONE"], group="Zone Engine • LTF")
ltf_near_atr = input.float(0.35, "LTF near ATR mult", minval=0.0, step=0.05, group="Zone Engine • LTF")
entry_break_len = input.int(2, "LTF trigger break lookback", minval=1, maxval=8, group="Zone Engine • LTF")

near_thr_atr = input.float(1.0, "Near threshold ATR multiple", minval=0.1, step=0.1, group="Stages")
use_rr_gate = input.bool(true, "Use RR gate", group="Stages")
rr_min = input.float(1.8, "Min RR", minval=0.5, step=0.1, group="Stages")
confirm_mode = input.string("SCORE", "Confirm mode", options=["ALL", "ANY", "SCORE"], group="Stages")
confirm_min_passed = input.int(2, "Confirm min passed", minval=1, maxval=4, group="Stages")
use_pp_confirm = input.bool(true, "Use PP", group="Stages")
use_trap_confirm = input.bool(false, "Use TRAP", group="Stages")
use_osc_confirm = input.bool(true, "Use RSI+MACD", group="Stages")

show_hud = input.bool(true, "Show HUD", group="Visual")
show_labels = input.bool(true, "Show stage icons", group="Visual")

int Z_ACTIVE = 0
int Z_TOUCHED = 1
int Z_CONSUMED = 2
int Z_INVALID = 3
int Z_EXPIRED = 4

string STAGE_FAR = "FAR"
string STAGE_NEAR = "NEAR"
string STAGE_IN_ZONE = "IN_ZONE"
string STAGE_LTF_READY = "LTF_READY"
string STAGE_CONFIRM_READY = "CONFIRM_READY"
string STAGE_ENTRY = "ENTRY"
string STAGE_BLOCKED = "BLOCKED"

f_box(int _l, float _t, int _r, float _b, color _bg, color _bd, int _bw) => box.new(_l, _t, _r, _b, xloc=xloc.bar_time, bgcolor=_bg, border_color=_bd, border_width=_bw)
f_label(int _x, float _y, string _t, color _c) => label.new(_x, _y, _t, xloc=xloc.bar_time, style=label.style_label_left, textcolor=color.white, color=_c, size=size.tiny)
f_tf_ms(string _tf) => int(timeframe.in_seconds(_tf) * 1000)

int tf_sec = timeframe.in_seconds()
string auto_htf1 = tf_sec <= 15 * 60 ? "240" : tf_sec <= 60 * 60 ? "D" : "W"
string auto_htf2 = tf_sec <= 15 * 60 ? "60" : tf_sec <= 60 * 60 ? "240" : "D"
string auto_ltf_by_chart = tf_sec <= 15 * 60 ? "5" : tf_sec <= 60 * 60 ? "15" : tf_sec <= 4 * 60 * 60 ? "60" : "240"
string htf1 = mode_tf == "AUTO" ? auto_htf1 : manual_htf1
string htf2 = mode_tf == "AUTO" ? auto_htf2 : manual_htf2
string ltf_auto = auto_ltf_mode == "CHART" ? timeframe.period : auto_ltf_mode == "AUTO_BY_HTF2" ? htf2 : auto_ltf_by_chart
string ltf = mode_tf == "AUTO" ? ltf_auto : (str.length(manual_ltf) == 0 ? timeframe.period : manual_ltf)

f_htf_pack(int _len, float _tol, int _touches_min, float _max_range_atr, int _exit_confirm) =>
    float atr = ta.atr(14)
    float hi = ta.highest(high, _len)
    float lo = ta.lowest(low, _len)
    float rng = hi - lo
    float eps = math.max(atr * _tol, syminfo.mintick)
    float touches = ta.sum((math.abs(high - hi) <= eps or math.abs(low - lo) <= eps) ? 1.0 : 0.0, _len)
    bool in_base = rng <= atr * _max_range_atr and touches >= _touches_min
    var bool prev_in_base = false
    var float base_hi = na
    var float base_lo = na
    var int out_cnt_up = 0
    var int out_cnt_dn = 0
    var int dir = 0
    bool edge = false
    if in_base
        base_hi := hi
        base_lo := lo
        out_cnt_up := 0
        out_cnt_dn := 0
    if not in_base and prev_in_base
        out_cnt_up := close > base_hi ? out_cnt_up + 1 : 0
        out_cnt_dn := close < base_lo ? out_cnt_dn + 1 : 0
        if out_cnt_up >= _exit_confirm
            dir := 1
            edge := true
            out_cnt_up := 0
            out_cnt_dn := 0
        if out_cnt_dn >= _exit_confirm
            dir := -1
            edge := true
            out_cnt_up := 0
            out_cnt_dn := 0
    prev_in_base := in_base
    float poc = ta.vwap(hlc3)
    [edge ? 1.0 : 0.0, base_hi, base_lo, atr, dir * 1.0, time * 1.0, close, open, poc]

[htf1_edge, htf1_bh, htf1_bl, htf1_atr, htf1_dirf, htf1_timef, htf1_close, htf1_open, htf1_poc] = request.security(syminfo.tickerid, htf1, f_htf_pack(base_len, touch_tolerance, min_touches, max_range_atr, exit_confirm_bars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htf2_edge, htf2_bh, htf2_bl, htf2_atr, htf2_dirf, htf2_timef, htf2_close, htf2_open, htf2_poc] = request.security(syminfo.tickerid, htf2, f_htf_pack(base_len, touch_tolerance, min_touches, max_range_atr, exit_confirm_bars), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

f_ltf_pack(int _accum_len) =>
    float atr = ta.atr(14)
    float ah = ta.highest(high, _accum_len)
    float al = ta.lowest(low, _accum_len)
    float poc = ta.vwap(hlc3)
    bool flat_ok = (ah - al) <= atr * 1.4
    float trig_up = ta.highest(high, entry_break_len)
    float trig_dn = ta.lowest(low, entry_break_len)
    [atr, ah, al, poc, flat_ok ? 1.0 : 0.0, trig_up, trig_dn]

[ltf_atr, ltf_ah, ltf_al, ltf_poc, ltf_flatf, ltf_trig_up, ltf_trig_dn] = request.security(syminfo.tickerid, ltf, f_ltf_pack(base_len), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

var int[] z_id = array.new_int()
var int[] z_type = array.new_int()
var int[] z_status = array.new_int()
var string[] z_tf = array.new_string()
var float[] z_top = array.new_float()
var float[] z_bot = array.new_float()
var float[] z_poc = array.new_float()
var float[] z_atr = array.new_float()
var int[] z_time = array.new_int()
var int[] z_touch = array.new_int()
var bool[] z_inside_prev = array.new_bool()
var box[] z_box = array.new_box()
var label[] z_label = array.new_label()
var int zid_seq = 0

f_zone_status_text(int _s) => _s == Z_ACTIVE ? "ACTIVE" : _s == Z_TOUCHED ? "TOUCHED" : _s == Z_CONSUMED ? "CONSUMED" : _s == Z_INVALID ? "INVALID" : "EXPIRED"

f_create_zone(int _type, string _tf, float _poc, float _atr, int _t) =>
    zid_seq += 1
    float pad = _atr * htf_poc_pad_mult
    float top = _poc + pad
    float bot = _poc - pad
    box b = f_box(_t, top, time + f_tf_ms(_tf) * 400, bot, color.new(_type == 1 ? color.green : color.red, _tf == htf1 ? 84 : 90), color.new(_type == 1 ? color.green : color.red, 0), 1)
    label lb = f_label(_t, _type == 1 ? bot : top, (_type == 1 ? "BUY" : "SELL") + " POC (" + _tf + ") " + str.tostring(_poc, format.mintick), color.new(_type == 1 ? color.green : color.red, 20))
    array.push(z_id, zid_seq)
    array.push(z_type, _type)
    array.push(z_status, Z_ACTIVE)
    array.push(z_tf, _tf)
    array.push(z_top, top)
    array.push(z_bot, bot)
    array.push(z_poc, _poc)
    array.push(z_atr, _atr)
    array.push(z_time, _t)
    array.push(z_touch, 0)
    array.push(z_inside_prev, false)
    array.push(z_box, b)
    array.push(z_label, lb)

f_remove_zone(int i) =>
    box b = array.get(z_box, i)
    label lb = array.get(z_label, i)
    if not na(b)
        box.delete(b)
    if not na(lb)
        label.delete(lb)
    array.remove(z_id, i)
    array.remove(z_type, i)
    array.remove(z_status, i)
    array.remove(z_tf, i)
    array.remove(z_top, i)
    array.remove(z_bot, i)
    array.remove(z_poc, i)
    array.remove(z_atr, i)
    array.remove(z_time, i)
    array.remove(z_touch, i)
    array.remove(z_inside_prev, i)
    array.remove(z_box, i)
    array.remove(z_label, i)

bool htf1_new = htf1_edge > 0 and htf1_edge[1] <= 0
bool htf2_new = htf2_edge > 0 and htf2_edge[1] <= 0
if htf1_new and htf1_dirf != 0
    f_create_zone(htf1_dirf > 0 ? 1 : -1, htf1, htf1_poc, htf1_atr, int(htf1_timef))
if htf2_new and htf2_dirf != 0
    f_create_zone(htf2_dirf > 0 ? 1 : -1, htf2, htf2_poc, htf2_atr, int(htf2_timef))

bool zone_created = htf1_new or htf2_new
bool zone_created_buy = (htf1_new and htf1_dirf > 0) or (htf2_new and htf2_dirf > 0)
bool zone_created_sell = (htf1_new and htf1_dirf < 0) or (htf2_new and htf2_dirf < 0)
bool zone_invalidated = false
bool zone_consumed = false
bool zone_flipped = false

for i = array.size(z_id) - 1 to 0
    int zi_status = array.get(z_status, i)
    string ztf = array.get(z_tf, i)
    float top = array.get(z_top, i)
    float bot = array.get(z_bot, i)
    float zat = array.get(z_atr, i)
    int zt = array.get(z_time, i)
    int ztp = array.get(z_type, i)
    int age = int((time - zt) / math.max(f_tf_ms(ztf), 1))
    bool inside = high >= bot and low <= top
    bool prev_inside = array.get(z_inside_prev, i)
    if inside and not prev_inside and zi_status <= Z_TOUCHED
        array.set(z_touch, i, array.get(z_touch, i) + 1)
        array.set(z_status, i, Z_TOUCHED)
    array.set(z_inside_prev, i, inside)

    float reaction = ztp == 1 ? high - top : bot - low
    bool consumed_now = array.get(z_touch, i) > 0 and reaction >= consume_reaction_atr_mult * zat
    if consumed_now and zi_status <= Z_TOUCHED
        array.set(z_status, i, Z_CONSUMED)
        zone_consumed := true

    float hclose = ztf == htf1 ? htf1_close : htf2_close
    float hopen = ztf == htf1 ? htf1_open : htf2_open
    bool body_dn = body_confirm ? (hclose < bot and hopen < bot) : hclose < bot
    bool body_up = body_confirm ? (hclose > top and hopen > top) : hclose > top
    bool inv_now = false
    if ztp == 1
        inv_now := ta.sum(body_dn ? 1.0 : 0.0, invalidate_confirm_bars) >= invalidate_confirm_bars
    if ztp == -1
        inv_now := ta.sum(body_up ? 1.0 : 0.0, invalidate_confirm_bars) >= invalidate_confirm_bars
    if inv_now and zi_status <= Z_TOUCHED
        array.set(z_status, i, Z_INVALID)
        zone_invalidated := true
        if flip_on_break
            f_create_zone(-ztp, ztf, array.get(z_poc, i), zat, time)
            zone_flipped := true

    if age > max_age_bars and zi_status <= Z_TOUCHED
        array.set(z_status, i, Z_EXPIRED)

    int st = array.get(z_status, i)
    bool keep = st == Z_ACTIVE or st == Z_TOUCHED or (show_consumed_history and st == Z_CONSUMED)
    if not keep
        f_remove_zone(i)
    else
        box b = array.get(z_box, i)
        label lb = array.get(z_label, i)
        if not na(b)
            box.set_right(b, time + f_tf_ms(ztf) * 400)
            box.set_border_width(b, st <= Z_TOUCHED ? 2 : 1)
        if not na(lb)
            label.set_text(lb, (ztp == 1 ? "BUY POC (" : "SELL POC (") + ztf + ") " + str.tostring(array.get(z_poc, i), format.mintick) + " " + f_zone_status_text(st))

while array.size(z_id) > max_zones_per_tf * 4
    f_remove_zone(0)

int buy_idx = -1
int sell_idx = -1
float buy_dist = 10e10
float sell_dist = 10e10
for i = 0 to array.size(z_id) - 1
    int st = array.get(z_status, i)
    if st <= Z_TOUCHED
        float top = array.get(z_top, i)
        float bot = array.get(z_bot, i)
        float d = close > top ? close - top : close < bot ? bot - close : 0
        int typ = array.get(z_type, i)
        if typ == 1 and d < buy_dist
            buy_dist := d
            buy_idx := i
        if typ == -1 and d < sell_dist
            sell_dist := d
            sell_idx := i

int active_buy_type = buy_idx >= 0 ? array.get(z_type, buy_idx) : 0
int active_sell_type = sell_idx >= 0 ? array.get(z_type, sell_idx) : 0
bool has_buy = buy_idx >= 0
bool has_sell = sell_idx >= 0

int active_idx = has_buy and (not has_sell or buy_dist <= sell_dist) ? buy_idx : has_sell ? sell_idx : -1
bool has_active = active_idx >= 0
int active_type = has_active ? array.get(z_type, active_idx) : 0
float active_top = has_active ? array.get(z_top, active_idx) : na
float active_bot = has_active ? array.get(z_bot, active_idx) : na
float active_atr = has_active ? array.get(z_atr, active_idx) : na

bool inside_now = has_active and high >= active_bot and low <= active_top
bool near_now = has_active and not inside_now and math.min(math.abs(close - active_top), math.abs(close - active_bot)) <= near_thr_atr * active_atr
var bool prev_inside_now = false
var bool prev_near_now = false
bool in_zone_edge = inside_now and not prev_inside_now
bool near_edge = near_now and not prev_near_now

float ltf_top = ltf_zone_mode == "ACCUM" ? ltf_ah : ltf_zone_mode == "FLAT" ? ltf_ah : ltf_poc + ltf_atr * 0.35
float ltf_bot = ltf_zone_mode == "ACCUM" ? ltf_al : ltf_zone_mode == "FLAT" ? ltf_al : ltf_poc - ltf_atr * 0.35
bool ltf_inside = high >= ltf_bot and low <= ltf_top
bool ltf_near = math.min(math.abs(close - ltf_top), math.abs(close - ltf_bot)) <= ltf_near_atr * ltf_atr
bool ltf_gate_ok = not use_ltf_entry_gate or (ltf_gate_mode == "IN_ZONE" ? ltf_inside : ltf_near)
bool ltf_ready_edge = ltf_gate_ok and not ltf_gate_ok[1]

float ema_fast = ta.ema(close, 34)
float ema_slow = ta.ema(close, 89)
int pp_dir = ema_fast > ema_slow ? 1 : ema_fast < ema_slow ? -1 : 0
bool pp_ok = not use_pp_confirm or pp_dir == active_type
float rsi = ta.rsi(close, 14)
float macd = ta.ema(close, 12) - ta.ema(close, 26)
float macd_sig = ta.ema(macd, 9)
bool osc_ok = not use_osc_confirm or (active_type == 1 ? (rsi > 50 and macd > macd_sig) : (rsi < 50 and macd < macd_sig))

var bool trap_buy_event = false
var bool trap_sell_event = false
trap_buy_event := ta.crossunder(low, active_bot) and close > active_bot
trap_sell_event := ta.crossover(high, active_top) and close < active_top
bool trap_ok = not use_trap_confirm or (active_type == 1 ? trap_buy_event : trap_sell_event)

float risk = has_active ? math.abs(close - (active_type == 1 ? active_bot : active_top)) : na
float reward = has_active ? math.abs((active_type == 1 ? close + active_atr * 2.0 : close - active_atr * 2.0) - close) : na
float rr = (not na(risk) and risk > syminfo.mintick and not na(reward)) ? reward / risk : 0
bool rr_ok = not use_rr_gate or rr >= rr_min

int confirms = (pp_ok ? 1 : 0) + (trap_ok ? 1 : 0) + (osc_ok ? 1 : 0) + (rr_ok ? 1 : 0)
bool confirm_ok = confirm_mode == "ALL" ? (pp_ok and trap_ok and osc_ok and rr_ok) : confirm_mode == "ANY" ? (pp_ok or trap_ok or osc_ok or rr_ok) : confirms >= confirm_min_passed

bool ltf_trigger_buy = ta.crossover(close, ltf_trig_up)
bool ltf_trigger_sell = ta.crossunder(close, ltf_trig_dn)
bool entry_trigger_ok = active_type == 1 ? ltf_trigger_buy : ltf_trigger_sell

string stage = STAGE_FAR
string block_reason = ""
if has_active
    if near_now
        stage := STAGE_NEAR
    if inside_now
        stage := STAGE_IN_ZONE
    if inside_now and ltf_gate_ok
        stage := STAGE_LTF_READY
    if inside_now and ltf_gate_ok and confirm_ok
        stage := STAGE_CONFIRM_READY
    if inside_now and ltf_gate_ok and confirm_ok and entry_trigger_ok
        stage := STAGE_ENTRY
    if inside_now and (not ltf_gate_ok or not confirm_ok)
        stage := STAGE_BLOCKED
        block_reason := not ltf_gate_ok ? "LTF gate" : "Confirm"

var string prev_stage = ""
bool stage_transition = stage != prev_stage
bool entry_edge = stage_transition and stage == STAGE_ENTRY
bool blocked_edge = stage_transition and stage == STAGE_BLOCKED
bool entry_buy_sig = entry_edge and active_type == 1
bool entry_sell_sig = entry_edge and active_type == -1

if show_labels and near_edge
    label.new(time, close, "⏳ NEAR", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)
if show_labels and in_zone_edge
    label.new(time, close, "⚡ IN_ZONE", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny)
if show_labels and ltf_ready_edge
    label.new(time, close, "✅ LTF_READY", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
if show_labels and entry_buy_sig
    label.new(time, close, "▲ ENTRY", xloc=xloc.bar_time, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)
if show_labels and entry_sell_sig
    label.new(time, close, "▼ ENTRY", xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
if show_labels and blocked_edge
    label.new(time, close, "⛔ BLOCKED " + block_reason, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)

alertcondition(near_edge and has_buy, "near_buy", "Price NEAR BUY zone")
alertcondition(near_edge and has_sell, "near_sell", "Price NEAR SELL zone")
alertcondition(in_zone_edge and active_type == 1, "in_zone_buy", "Price entered BUY zone")
alertcondition(in_zone_edge and active_type == -1, "in_zone_sell", "Price entered SELL zone")
alertcondition(ltf_ready_edge and active_type == 1, "ltf_ready_buy", "LTF gate ready for BUY")
alertcondition(ltf_ready_edge and active_type == -1, "ltf_ready_sell", "LTF gate ready for SELL")
alertcondition(stage_transition and stage == STAGE_CONFIRM_READY and active_type == 1, "confirm_ready_buy", "Confirm ready BUY")
alertcondition(stage_transition and stage == STAGE_CONFIRM_READY and active_type == -1, "confirm_ready_sell", "Confirm ready SELL")
alertcondition(entry_buy_sig, "entry_buy", "ENTRY BUY")
alertcondition(entry_sell_sig, "entry_sell", "ENTRY SELL")
alertcondition(blocked_edge and active_type == 1, "blocked_buy", "BUY blocked")
alertcondition(blocked_edge and active_type == -1, "blocked_sell", "SELL blocked")
alertcondition(zone_created, "zone_created", "HTF zone created")
alertcondition(zone_invalidated, "zone_invalidated", "HTF zone invalidated")
alertcondition(zone_consumed, "zone_consumed", "HTF zone consumed")
alertcondition(zone_flipped, "zone_flipped", "HTF zone flipped")
alertcondition(trap_buy_event, "trap_event_buy", "Trap event BUY")
alertcondition(trap_sell_event, "trap_event_sell", "Trap event SELL")

var table hud = table.new(position.top_right, 7, 4, bgcolor=color.new(color.black, 80))
if barstate.islast and show_hud
    table.cell(hud, 0, 0, "SIDE", text_color=color.white)
    table.cell(hud, 1, 0, "ZONE", text_color=color.white)
    table.cell(hud, 2, 0, "DIST", text_color=color.white)
    table.cell(hud, 3, 0, "AGE/TCH", text_color=color.white)
    table.cell(hud, 4, 0, "STATUS", text_color=color.white)
    table.cell(hud, 5, 0, "MOD", text_color=color.white)
    table.cell(hud, 6, 0, "TF", text_color=color.white)
    string btxt = has_buy ? str.tostring(array.get(z_poc, buy_idx), format.mintick) + " [" + str.tostring(array.get(z_bot, buy_idx), format.mintick) + ";" + str.tostring(array.get(z_top, buy_idx), format.mintick) + "]" : "n/a"
    string st_b = has_buy ? f_zone_status_text(array.get(z_status, buy_idx)) : "-"
    string ageb = has_buy ? str.tostring(int((time - array.get(z_time, buy_idx)) / math.max(f_tf_ms(array.get(z_tf, buy_idx)), 1))) + "/" + str.tostring(array.get(z_touch, buy_idx)) : "-"
    table.cell(hud, 0, 1, "BUY", text_color=color.lime)
    table.cell(hud, 1, 1, btxt, text_color=color.white)
    table.cell(hud, 2, 1, has_buy ? str.tostring(buy_dist, format.mintick) : "-", text_color=color.white)
    table.cell(hud, 3, 1, ageb, text_color=color.white)
    table.cell(hud, 4, 1, st_b, text_color=color.white)
    table.cell(hud, 5, 1, "RR:" + (rr_ok ? "OK" : "BAD") + " PP:" + (pp_ok ? "OK" : "WAI") + " TR:" + (trap_ok ? "OK" : "WAI") + " OSC:" + (osc_ok ? "OK" : "BAD") + " LTF:" + (ltf_gate_ok ? "OK" : "WAI") + " TG:" + (entry_trigger_ok ? "OK" : "WAI"), text_color=color.silver)
    table.cell(hud, 6, 1, has_buy ? array.get(z_tf, buy_idx) : "-", text_color=color.white)
    string stxt = has_sell ? str.tostring(array.get(z_poc, sell_idx), format.mintick) + " [" + str.tostring(array.get(z_bot, sell_idx), format.mintick) + ";" + str.tostring(array.get(z_top, sell_idx), format.mintick) + "]" : "n/a"
    string st_s = has_sell ? f_zone_status_text(array.get(z_status, sell_idx)) : "-"
    string ages = has_sell ? str.tostring(int((time - array.get(z_time, sell_idx)) / math.max(f_tf_ms(array.get(z_tf, sell_idx)), 1))) + "/" + str.tostring(array.get(z_touch, sell_idx)) : "-"
    table.cell(hud, 0, 2, "SELL", text_color=color.red)
    table.cell(hud, 1, 2, stxt, text_color=color.white)
    table.cell(hud, 2, 2, has_sell ? str.tostring(sell_dist, format.mintick) : "-", text_color=color.white)
    table.cell(hud, 3, 2, ages, text_color=color.white)
    table.cell(hud, 4, 2, st_s, text_color=color.white)
    table.cell(hud, 5, 2, "RR:" + (rr_ok ? "OK" : "BAD") + " PP:" + (pp_ok ? "OK" : "WAI") + " TR:" + (trap_ok ? "OK" : "WAI") + " OSC:" + (osc_ok ? "OK" : "BAD") + " LTF:" + (ltf_gate_ok ? "OK" : "WAI") + " TG:" + (entry_trigger_ok ? "OK" : "WAI"), text_color=color.silver)
    table.cell(hud, 6, 2, has_sell ? array.get(z_tf, sell_idx) : "-", text_color=color.white)
    table.cell(hud, 0, 3, "STAGE", text_color=color.white)
    table.cell(hud, 1, 3, stage, text_color=stage == STAGE_ENTRY ? color.lime : stage == STAGE_BLOCKED ? color.red : color.white)
    table.cell(hud, 2, 3, block_reason, text_color=color.orange)
    table.cell(hud, 3, 3, htf1 + "/" + htf2 + "/" + ltf, text_color=color.silver)

prev_stage := stage
prev_inside_now := inside_now
prev_near_now := near_now
