//@version=6
indicator("Prizrak Trade Setup Detector v12.0.0", overlay=true, max_boxes_count=300, max_labels_count=300)

mode_tf = input.string("AUTO", "TF mode", options=["AUTO", "MANUAL"], group="TF Hierarchy")
manual_htf1 = input.timeframe("240", "Manual HTF1", group="TF Hierarchy")
manual_htf2 = input.timeframe("60", "Manual HTF2", group="TF Hierarchy")
manual_ltf = input.timeframe("", "Manual LTF (blank = chart)", group="TF Hierarchy")

pivot_left = input.int(3, "Pivot left bars", minval=1, maxval=20, group="Zone Engine • HTF")
pivot_right = input.int(3, "Pivot right bars", minval=1, maxval=20, group="Zone Engine • HTF")
htf_zone_atr_mult = input.float(0.35, "HTF zone ATR multiplier", minval=0.05, step=0.05, group="Zone Engine • HTF")
invalidate_atr_mult = input.float(0.2, "Invalidation ATR pad", minval=0.0, step=0.05, group="Zone Engine • HTF")
max_zones_per_tf = input.int(6, "Max zones per TF per side", minval=1, maxval=20, group="Zone Engine • HTF")
max_touches = input.int(5, "Max touches before invalidate", minval=1, maxval=20, group="Zone Engine • HTF")
max_age_bars = input.int(700, "Max age bars", minval=50, maxval=5000, group="Zone Engine • HTF")
zone_extend_bars = input.int(400, "Zone extend bars", minval=20, maxval=5000, group="Zone Engine • HTF")

ltf_zone_mode = input.string("POC", "LTF entry zone mode", options=["POC", "ACCUM"], group="Zone Engine • LTF")
poc_len = input.int(48, "POC length", minval=10, maxval=500, group="Zone Engine • LTF")
poc_atr_mult = input.float(0.35, "POC ATR multiplier", minval=0.05, step=0.05, group="Zone Engine • LTF")
accum_len = input.int(24, "Accum range length", minval=5, maxval=200, group="Zone Engine • LTF")
accum_max_atr = input.float(1.2, "Accum max range in ATR", minval=0.3, step=0.1, group="Zone Engine • LTF")

near_thr_atr = input.float(0.9, "Near threshold ATR multiple", minval=0.1, step=0.1, group="Stages")
use_pp_confirm = input.bool(true, "Use CHOCH/PP confirm", group="Stages")
use_trap_confirm = input.bool(true, "Use trap-return confirm", group="Stages")
use_rsi_macd = input.bool(true, "Use RSI + MACD filter", group="Stages")
use_rr_gate = input.bool(true, "Use RR gate", group="Stages")
rr_min = input.float(1.8, "Min RR", minval=0.5, step=0.1, group="Stages")
entry_break_len = input.int(2, "Entry trigger lookback", minval=1, maxval=10, group="Stages")

show_hud = input.bool(true, "Show HUD", group="Visual")
show_labels = input.bool(true, "Show labels/icons", group="Visual")

int tf_sec = timeframe.in_seconds()
string auto_htf1 = tf_sec <= 15 * 60 ? "240" : tf_sec <= 60 * 60 ? "D" : "W"
string auto_htf2 = tf_sec <= 15 * 60 ? "60" : tf_sec <= 60 * 60 ? "240" : "D"
string auto_ltf = timeframe.period
string htf1 = mode_tf == "AUTO" ? auto_htf1 : manual_htf1
string htf2 = mode_tf == "AUTO" ? auto_htf2 : manual_htf2
string ltf = mode_tf == "AUTO" ? auto_ltf : (str.length(manual_ltf) == 0 ? timeframe.period : manual_ltf)

f_box(float _l, float _t, float _r, float _b, color _bg, color _bd, int _bw) => box.new(_l, _t, _r, _b, xloc=xloc.bar_index, bgcolor=_bg, border_color=_bd, border_width=_bw)
f_label(float _x, float _y, string _txt, color _bg, color _tc, int _style) => label.new(_x, _y, _txt, xloc=xloc.bar_index, style=_style, textcolor=_tc, color=_bg)
f_del_box(box _b) => if not na(_b)
    box.delete(_b)
f_del_label(label _l) => if not na(_l)
    label.delete(_l)

var float[] z_top = array.new_float()
var float[] z_bot = array.new_float()
var int[] z_type = array.new_int() // 1 demand, -1 supply
var string[] z_tf = array.new_string()
var int[] z_created = array.new_int()
var int[] z_touch = array.new_int()
var bool[] z_active = array.new_bool()
var box[] z_box = array.new_box()
var label[] z_label = array.new_label()
var bool[] z_near_once = array.new_bool()
var bool[] z_in_once = array.new_bool()
var label[] event_labels = array.new_label()

f_prune_events() =>
    while array.size(event_labels) > 40
        label old = array.shift(event_labels)
        f_del_label(old)

f_event(string _text, float _price, color _bg, int _style) =>
    if show_labels
        label lb = f_label(bar_index, _price, _text, _bg, color.white, _style)
        array.push(event_labels, lb)
        f_prune_events()

f_count_tf_type(string _tf, int _type) =>
    int c = 0
    for i = 0 to array.size(z_top) - 1
        if array.get(z_tf, i) == _tf and array.get(z_type, i) == _type
            c += 1
    c

f_prune_tf_type(string _tf, int _type) =>
    while f_count_tf_type(_tf, _type) >= max_zones_per_tf
        int kill = na
        int oldest = 1000000000
        for i = 0 to array.size(z_top) - 1
            if array.get(z_tf, i) == _tf and array.get(z_type, i) == _type
                int c = array.get(z_created, i)
                if c < oldest
                    oldest := c
                    kill := i
        if not na(kill)
            f_del_box(array.get(z_box, kill))
            f_del_label(array.get(z_label, kill))
            array.remove(z_top, kill)
            array.remove(z_bot, kill)
            array.remove(z_type, kill)
            array.remove(z_tf, kill)
            array.remove(z_created, kill)
            array.remove(z_touch, kill)
            array.remove(z_active, kill)
            array.remove(z_box, kill)
            array.remove(z_label, kill)
            array.remove(z_near_once, kill)
            array.remove(z_in_once, kill)
        else
            break

f_add_zone(float _top, float _bot, int _type, string _tf) =>
    f_prune_tf_type(_tf, _type)
    color fill = _type == 1 ? color.new(color.green, _tf == htf1 ? 86 : 90) : color.new(color.red, _tf == htf1 ? 86 : 90)
    color border = _type == 1 ? color.new(color.lime, 0) : color.new(color.orange, 0)
    box b = f_box(bar_index, _top, bar_index + zone_extend_bars, _bot, fill, border, 1)
    label lb = show_labels ? f_label(bar_index, _type == 1 ? _bot : _top, (_type == 1 ? "DEMAND " : "SUPPLY ") + _tf, color.new(color.black, 70), color.white, label.style_label_left) : na
    array.push(z_top, _top)
    array.push(z_bot, _bot)
    array.push(z_type, _type)
    array.push(z_tf, _tf)
    array.push(z_created, bar_index)
    array.push(z_touch, 0)
    array.push(z_active, true)
    array.push(z_box, b)
    array.push(z_label, lb)
    array.push(z_near_once, false)
    array.push(z_in_once, false)

f_process_htf(string _tf) =>
    float pH = request.security(syminfo.tickerid, _tf, ta.pivothigh(high, pivot_left, pivot_right), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float pL = request.security(syminfo.tickerid, _tf, ta.pivotlow(low, pivot_left, pivot_right), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float atrH = request.security(syminfo.tickerid, _tf, ta.atr(14), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    bool newPH = not na(pH) and na(pH[1])
    bool newPL = not na(pL) and na(pL[1])
    if newPH
        float pad = atrH * htf_zone_atr_mult
        f_add_zone(pH + pad, pH - pad, -1, _tf)
    if newPL
        float pad = atrH * htf_zone_atr_mult
        f_add_zone(pL + pad, pL - pad, 1, _tf)

f_process_htf(htf1)
f_process_htf(htf2)

float atr = ta.atr(14)
float near_thr = atr * near_thr_atr
float invalidate_pad = atr * invalidate_atr_mult

float htf1_close = request.security(syminfo.tickerid, htf1, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
float htf1_ema = request.security(syminfo.tickerid, htf1, ta.ema(close, 50), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
int bias = htf1_close > htf1_ema ? 1 : htf1_close < htf1_ema ? -1 : 0

int active_idx = na
float best_dist = 1000000000.0
for i = 0 to array.size(z_top) - 1
    bool active = array.get(z_active, i)
    if active
        float top = array.get(z_top, i)
        float bot = array.get(z_bot, i)
        int typ = array.get(z_type, i)
        bool touched = close <= top and close >= bot
        if touched
            array.set(z_touch, i, array.get(z_touch, i) + 1)
        int age = bar_index - array.get(z_created, i)
        bool invalid = (typ == -1 and close > top + invalidate_pad) or (typ == 1 and close < bot - invalidate_pad) or array.get(z_touch, i) >= max_touches or age > max_age_bars
        if invalid
            array.set(z_active, i, false)
        else
            float dist = close > top ? close - top : close < bot ? bot - close : 0.0
            bool pref = bias == 0 or (bias == 1 and typ == 1) or (bias == -1 and typ == -1)
            float score = pref ? dist : dist + atr * 3
            if score < best_dist
                best_dist := score
                active_idx := i

string stage = "FAR"
string next_action = "Wait"
string block_reason = ""
bool near_buy = false
bool near_sell = false
bool in_buy = false
bool in_sell = false
bool entry_buy_sig = false
bool entry_sell_sig = false
bool blocked_sig = false
bool zone_created_buy = false
bool zone_created_sell = false

zone_created_buy := array.size(z_type) > 0 and array.get(z_created, array.size(z_created) - 1) == bar_index and array.get(z_type, array.size(z_type) - 1) == 1
zone_created_sell := array.size(z_type) > 0 and array.get(z_created, array.size(z_created) - 1) == bar_index and array.get(z_type, array.size(z_type) - 1) == -1

bool has_active = not na(active_idx)
int active_type = has_active ? array.get(z_type, active_idx) : 0
float active_top = has_active ? array.get(z_top, active_idx) : na
float active_bot = has_active ? array.get(z_bot, active_idx) : na
float active_dist = has_active ? (close > active_top ? close - active_top : close < active_bot ? active_bot - close : 0.0) : na
bool inside_active = has_active and close <= active_top and close >= active_bot

bool choch_buy = ta.crossover(close, ta.highest(high, 8)[1])
bool choch_sell = ta.crossunder(close, ta.lowest(low, 8)[1])
bool trap_buy = has_active and active_type == 1 and low[1] < active_bot and close > active_bot
bool trap_sell = has_active and active_type == -1 and high[1] > active_top and close < active_top
float rsi = ta.rsi(close, 14)
[macd_line, macd_sig, _] = ta.macd(close, 12, 26, 9)
bool rsi_macd_buy = rsi > 50 and macd_line > macd_sig
bool rsi_macd_sell = rsi < 50 and macd_line < macd_sig
float buy_risk = has_active ? close - active_bot : na
float sell_risk = has_active ? active_top - close : na
float buy_rr = buy_risk > 0 ? (atr * 3) / buy_risk : na
float sell_rr = sell_risk > 0 ? (atr * 3) / sell_risk : na
bool rr_buy_ok = not use_rr_gate or (not na(buy_rr) and buy_rr >= rr_min)
bool rr_sell_ok = not use_rr_gate or (not na(sell_rr) and sell_rr >= rr_min)

var box ltf_box = na
var label ltf_label = na
if has_active and (inside_active or active_dist <= near_thr)
    float l_top = na
    float l_bot = na
    if ltf_zone_mode == "POC"
        float poc = ta.vwma(close, poc_len)
        float pad = atr * poc_atr_mult
        l_top := poc + pad
        l_bot := poc - pad
    else
        float hi = ta.highest(high, accum_len)
        float lo = ta.lowest(low, accum_len)
        bool ok = (hi - lo) <= atr * accum_max_atr
        l_top := ok ? hi : na
        l_bot := ok ? lo : na
    if not na(l_top) and not na(l_bot)
        if na(ltf_box)
            ltf_box := f_box(bar_index, l_top, bar_index + zone_extend_bars, l_bot, color.new(color.aqua, 88), color.new(color.aqua, 0), 1)
            ltf_label := show_labels ? f_label(bar_index, l_top, "ENTRY ZONE " + ltf, color.new(color.black, 70), color.white, label.style_label_left) : na
        else
            box.set_left(ltf_box, bar_index)
            box.set_right(ltf_box, bar_index + zone_extend_bars)
            box.set_top(ltf_box, l_top)
            box.set_bottom(ltf_box, l_bot)
            if not na(ltf_label)
                label.set_x(ltf_label, bar_index)
                label.set_y(ltf_label, l_top)

if has_active
    int zt = active_type
    for i = 0 to array.size(z_top) - 1
        if array.get(z_active, i)
            box b = array.get(z_box, i)
            float top = array.get(z_top, i)
            float bot = array.get(z_bot, i)
            box.set_left(b, array.get(z_created, i))
            box.set_right(b, bar_index + zone_extend_bars)
            box.set_top(b, top)
            box.set_bottom(b, bot)
            bool is_active = i == active_idx
            box.set_border_width(b, is_active ? 2 : 1)
            box.set_border_color(b, is_active ? color.yellow : (array.get(z_type, i) == 1 ? color.lime : color.orange))
            label lb = array.get(z_label, i)
            if not na(lb)
                label.set_x(lb, bar_index)
                label.set_y(lb, array.get(z_type, i) == 1 ? bot : top)
                label.set_text(lb, (array.get(z_type, i) == 1 ? "DEMAND " : "SUPPLY ") + array.get(z_tf, i) + (is_active ? " ACTIVE" : ""))

if has_active
    if inside_active
        stage := "IN_ZONE"
        next_action := "Wait confirm"
        in_buy := active_type == 1
        in_sell := active_type == -1
        bool pp_ok = not use_pp_confirm or (active_type == 1 ? choch_buy : choch_sell)
        bool trap_ok = not use_trap_confirm or (active_type == 1 ? trap_buy : trap_sell)
        bool osc_ok = not use_rsi_macd or (active_type == 1 ? rsi_macd_buy : rsi_macd_sell)
        bool rr_ok = active_type == 1 ? rr_buy_ok : rr_sell_ok
        bool confirm_ok = pp_ok and trap_ok and osc_ok and rr_ok
        if confirm_ok
            stage := "CONFIRM"
            next_action := "Wait trigger"
            bool trig_buy = active_type == 1 and ta.crossover(close, ta.highest(high, entry_break_len)[1])
            bool trig_sell = active_type == -1 and ta.crossunder(close, ta.lowest(low, entry_break_len)[1])
            if trig_buy or trig_sell
                stage := "ENTRY"
                next_action := trig_buy ? "▲ BUY" : "▼ SELL"
                entry_buy_sig := trig_buy
                entry_sell_sig := trig_sell
                if trig_buy
                    f_event("▲ BUY RR=" + str.tostring(buy_rr, "#.##"), low, color.new(color.green, 0), label.style_label_up)
                if trig_sell
                    f_event("▼ SELL RR=" + str.tostring(sell_rr, "#.##"), high, color.new(color.red, 0), label.style_label_down)
        else
            stage := "BLOCKED"
            blocked_sig := true
            block_reason := not pp_ok ? "PP" : not trap_ok ? "TRAP" : not osc_ok ? "RSI/MACD" : "RR"
            next_action := "Fix " + block_reason
    else if active_dist <= near_thr
        stage := "NEAR"
        next_action := active_type == 1 ? "⏳ prepare BUY" : "⏳ prepare SELL"
        near_buy := active_type == 1
        near_sell := active_type == -1
        bool done = array.get(z_near_once, active_idx)
        if not done
            f_event(active_type == 1 ? "⏳ готовимся BUY" : "⏳ готовимся SELL", close, color.new(color.blue, 0), label.style_label_left)
            array.set(z_near_once, active_idx, true)
    else
        stage := "FAR"
        next_action := "Wait approach"

if has_active and inside_active and not array.get(z_in_once, active_idx)
    f_event("⚡ IN ZONE", close, color.new(color.purple, 0), label.style_label_left)
    array.set(z_in_once, active_idx, true)

alertcondition(zone_created_buy, "zone_created_buy", "New BUY (demand) zone created")
alertcondition(zone_created_sell, "zone_created_sell", "New SELL (supply) zone created")
alertcondition(near_buy, "price_near_buy_zone", "Price is near BUY zone")
alertcondition(near_sell, "price_near_sell_zone", "Price is near SELL zone")
alertcondition(in_buy, "price_in_buy_zone", "Price is inside BUY zone")
alertcondition(in_sell, "price_in_sell_zone", "Price is inside SELL zone")
alertcondition(entry_buy_sig, "entry_buy", "ENTRY BUY trigger")
alertcondition(entry_sell_sig, "entry_sell", "ENTRY SELL trigger")
alertcondition(blocked_sig, "entry_blocked", "Entry blocked; check HUD block reason")

var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 80))
if barstate.islast and show_hud
    table.cell(hud, 0, 0, "Bias", text_color=color.white)
    table.cell(hud, 1, 0, bias == 1 ? "BUY" : bias == -1 ? "SELL" : "NEUTRAL", text_color=bias == 1 ? color.lime : bias == -1 ? color.red : color.silver)
    table.cell(hud, 0, 1, "Active zone", text_color=color.white)
    string zone_txt = has_active ? (array.get(z_tf, active_idx) + " " + (active_type == 1 ? "DEMAND" : "SUPPLY")) : "none"
    table.cell(hud, 1, 1, zone_txt, text_color=color.white)
    table.cell(hud, 0, 2, "Stage", text_color=color.white)
    table.cell(hud, 1, 2, stage, text_color=stage == "ENTRY" ? color.lime : stage == "BLOCKED" ? color.red : color.white)
    table.cell(hud, 0, 3, "Next action", text_color=color.white)
    table.cell(hud, 1, 3, next_action, text_color=color.white)
    table.cell(hud, 0, 4, "Block reason", text_color=color.white)
    table.cell(hud, 1, 4, block_reason, text_color=color.orange)
